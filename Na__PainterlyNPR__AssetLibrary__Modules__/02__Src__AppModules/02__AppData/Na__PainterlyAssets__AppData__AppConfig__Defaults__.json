            "07/Conifers"        : { "generator": "Conifer",     "kind": "Conifer",   "material": "Conifer",     "role": "Planting",  "autoRotate": true , "facing": "Random", "autoScale": true , "scaleJitter": 0.1,  "newShapeEachPlop": true,  "season": "AllYear" },
            "07/Hedges"          : { "generator": "Hedge",       "kind": "Hedge",     "material": "Hedge",       "role": "Planting",  "autoRotate": false, "facing": "Camera", "autoScale": false, "scaleJitter": 0.03, "newShapeEachPlop": true,  "season": "AllYear" },
