# Unit tests for 12__McpOperations and the library SafeLoad, run with SketchUp's
# bundled Ruby (no SketchUp process):
#   python <Plugins>/Na__SketchUpMcp__Modules__/40__Tests__Validation/Na__SketchUpMcp__Tests__RunRubyChecks__.py <this file>
# A throwaway library is built in a temp folder; a small fake SketchUp model
# stands in for definitions.load / save_as / start_operation / abort_operation.
Encoding.const_set(:UTF_8, Encoding.find('UTF-8')) unless Encoding.const_defined?(:UTF_8)
Encoding.const_set(:BINARY, Encoding.find('ASCII-8BIT')) unless Encoding.const_defined?(:BINARY)
require 'json'
require 'fileutils'
require 'tmpdir'

NA_TEST_MODULE_ROOT = File.expand_path('..', __dir__)
$na_failures = []
$na_checks = 0

def check(label)
    $na_checks += 1
    ok = begin
        yield
    rescue StandardError => error
        $na_failures << "#{label} (raised #{error.class}: #{error.message})"
        return
    end
    $na_failures << label unless ok
end

# --- Fake SketchUp --------------------------------------------------------------

class NaFakeDefinition
    attr_accessor :name, :description, :path
    attr_writer :instances

    def initialize(name, path)
        @name = name
        @path = path
        @description = ''
        @attrs = {}
        @instances = 0
    end

    def group?; false; end
    def image?; false; end
    def valid?; true; end
    def count_instances; @instances; end

    def attribute_dictionary(dict_name, create = false)
        return @attrs[dict_name] if @attrs.key?(dict_name)

        create ? (@attrs[dict_name] = {}) : nil
    end

    def get_attribute(dict_name, key, default_value = nil)
        (@attrs[dict_name] || {}).fetch(key, default_value)
    end

    def delete_attribute(dict_name, key)
        (@attrs[dict_name] || {}).delete(key)
    end

    def attrs_copy
        JSON.parse(JSON.generate(@attrs))
    end

    def restore(snapshot)
        @name = snapshot[:name]
        @description = snapshot[:description]
        @attrs = snapshot[:attrs]
    end

    def save_as(target)
        File.write(target, JSON.generate('name' => @name, 'description' => @description, 'attrs' => @attrs))
        true
    end
end

class NaFakeDefinitions
    include Enumerable

    def initialize
        @list = []
    end

    attr_reader :list

    def each(&block)
        @list.each(&block)
    end

    def load(path)
        existing = @list.find { |definition| definition.path == path }
        return existing if existing

        data = JSON.parse(File.read(path)) rescue {}
        definition = NaFakeDefinition.new(data['name'] || File.basename(path, '.skp'), path)
        (data['attrs'] || {}).each { |dict_name, values| values.each { |key, value| definition.attribute_dictionary(dict_name, true)[key] = value } }
        @list << definition
        definition
    end

    def unique_name(base)
        "#{base}#1"
    end
end

class NaFakeModel
    attr_reader :definitions, :aborted, :committed

    def initialize
        @definitions = NaFakeDefinitions.new
        @aborted = 0
        @committed = 0
    end

    def start_operation(_name, _disable_ui = false)
        @snapshot_list = @definitions.list.dup
        @snapshot_state = @definitions.list.map { |definition| [definition, { name: definition.name, description: definition.description, attrs: definition.attrs_copy }] }
    end

    def abort_operation
        @aborted += 1
        @definitions.list.replace(@snapshot_list)
        @snapshot_state.each { |definition, state| definition.restore(state) }
    end

    def commit_operation
        @committed += 1
    end
end

module Sketchup
    def self.active_model
        $na_fake_model
    end

    def self.temp_dir
        Dir.tmpdir
    end
end

# --- Load the real code, with a stub user config ----------------------------------

module Na__ComponentEditorTools
    module Na__UserConfig
        def self.Na__ComponentEditorTools__LibraryPath; $na_library_root; end
        def self.Na__ComponentEditorTools__BlockedFolders; ['00__Archive', '00__Retired', '95__TEMP__Ripdown']; end
        def self.Na__ComponentEditorTools__BlockedFiles; []; end
        def self.Na__ComponentEditorTools__FolderAliases; { 'Na__CoreLib__3dAssets' => { 'alias' => 'Noble Architecture', 'order' => 2 } }; end
    end
end

%w[
    01__AppCore/Na__ComponentEditorTools__AppCore__PathResolver__.rb
    08__LibraryManager/Na__ComponentEditorTools__LibraryManager__Scanner__.rb
    08__LibraryManager/Na__ComponentEditorTools__LibraryManager__Serializer__.rb
    08__LibraryManager/Na__ComponentEditorTools__LibraryManager__SafeLoad__.rb
    12__McpOperations/Na__ComponentEditorTools__McpOperations__Main__.rb
    12__McpOperations/Na__ComponentEditorTools__McpOperations__Convention__.rb
    12__McpOperations/Na__ComponentEditorTools__McpOperations__Catalogue__.rb
    12__McpOperations/Na__ComponentEditorTools__McpOperations__Archive__.rb
    12__McpOperations/Na__ComponentEditorTools__McpOperations__Plan__.rb
    12__McpOperations/Na__ComponentEditorTools__McpOperations__AssetOps__.rb
].each { |relative| load File.join(NA_TEST_MODULE_ROOT, relative) }

CONV = Na__ComponentEditorTools::Na__McpConvention
CONV.Na__ComponentEditorTools__UseConfigPath(File.join(NA_TEST_MODULE_ROOT, '07__UserData', 'Na__ComponentEditorTools__LibraryConvention__.json'))
OPS = Na__ComponentEditorTools::Na__McpOperations

def fake_skp(path, name, attrs = {})
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, JSON.generate('name' => name, 'attrs' => attrs))
end

def build_library
    $na_fake_model = NaFakeModel.new
    $na_library_root = File.join(Dir.mktmpdir('na_lib_'), 'Lib').tr('\\', '/')
    set = File.join($na_library_root, 'Na__CoreLib__3dAssets')
    fake_skp("#{set}/13__Building__Roof/13_2000__ChimneyPots/13_2021__ChimneyPot__Tall__Type-01__.skp", '13_2021__ChimneyPot__Tall__Type-01__')
    fake_skp("#{set}/13__Building__Roof/13_2000__ChimneyPots/13_2025__ChimneyPot__Covered__Type-05__.skp", '13_2025__ChimneyPot__Covered__Type-05__')
    fake_skp("#{set}/13__Building__Roof/13_2000__ChimneyPots/13_2025__ChimneyPot__Covered__Type-07.skp", '13_2025__ChimneyPot__Covered__Type-07')
    fake_skp("#{set}/13__Building__Roof/13_2000__ChimneyPots/04_Whitecard__ChimneyPot__Type-02__.skp", '04_Whitecard__ChimneyPot__Type-02__')
    fake_skp("#{set}/17__Building__Fixtures/4000__Bathroom/27_4003__Bathroom__Toilet__Standard__Type-03__.skp", '27_4003__Bathroom__Toilet__Standard__Type-03__',
             'Na__ComponentLibrary' => { 'gallery_name' => 'Toilet', 'truevision_valid' => 'true' })
    fake_skp("#{set}/60__Scene__Entourage__2D/60_0301__SceneEntourage__Man__Var-01__.skp", '60_0301__SceneEntourage__Man__Var-01__')
    fake_skp("#{set}/60__Scene__Entourage__2D/60_0321__SceneEntourage__Woman__Var-01__.skp", '60_0321__SceneEntourage__Woman__Var-01__')
    fake_skp("#{set}/00__Archive/13_2022__ChimneyPot__Old__.skp", '13_2022__ChimneyPot__Old__')
    File.write("#{set}/17__Building__Fixtures/4000__Bathroom/27_50__Old__.skb", 'backup')
    set
end

# --- Convention -----------------------------------------------------------------------

check('filed name parses') { p = CONV.Na__ComponentEditorTools__ParseName('13_5001__Roof__RidgeFinial__FleurDeLis__Type-01__.skp'); p['kind'] == 'filed' && p['code'] == '13_5001' && p['segments'] == %w[Roof RidgeFinial FleurDeLis Type-01] && p['trailing_underscores'] }
check('short code') { CONV.Na__ComponentEditorTools__ParseName('27_22__Bathroom__Sink____')['kind'] == 'short_code' }
check('letter code') { CONV.Na__ComponentEditorTools__ParseName('ADR6001__RoofLight__Velux__')['kind'] == 'letter_code' }
check('old prefix') { CONV.Na__ComponentEditorTools__ParseName('04_Whitecard__ChimneyPot__Type-02__')['kind'] == 'old_prefix' }
check('unfiled prefixes') { %w[85__Bracket RIPDOWN__ChimneyPot VALIDATE__HOPPER 95__TEMP__X].all? { |n| CONV.Na__ComponentEditorTools__ParseName(n)['kind'] == 'unfiled' } }
check('uncoded') { CONV.Na__ComponentEditorTools__ParseName('skp98B3.tmp')['kind'] == 'uncoded' }
check('85_85 short code, not unfiled') { CONV.Na__ComponentEditorTools__ParseName('85_85__Stairs__NewelPost__Type-01')['kind'] == 'short_code' }

rules = ->(stem, folder = '') { CONV.Na__ComponentEditorTools__CheckAsset(stem, folder)['issues'].map { |i| i['rule'] } }
check('missing trailing __ warns') { rules.call('13_2021__ChimneyPot__Tall__Type-01', '13__Building__Roof/13_2000__ChimneyPots').include?('trailing_underscores') }
check('typo found') { rules.call('90_9001__OudoorLiving__CoffeeTable__', '18__Objects__Furniture').include?('typo') }
check('mangled name found') { rules.call('13_5001__Roof__Type-#1').include?('mangled_name') }
check('spaces found') { rules.call('Temp Bath 2').include?('spaces') }
check('line break found') { rules.call("85_02__Sofa__L1400mmxW865mm\n").include?('control_characters') }
check('category mismatch') { rules.call('27_4003__Bathroom__Toilet__', '17__Building__Fixtures/17_4000__Bathroom').include?('category_mismatch') }
check('bare series folder') { rules.call('17_4003__Bathroom__Toilet__', '17__Building__Fixtures/4000__Bathroom').include?('series_folder_name') }
check('series mismatch') { rules.call('13_6001__RoofLight__', '13__Building__Roof/13_2000__ChimneyPots').include?('series_mismatch') }
check('clean name has no issues') { rules.call('13_2021__ChimneyPot__Tall__Type-01__', '13__Building__Roof/13_2000__ChimneyPots').empty? }
check('set root warns') { rules.call('85__Bracket__Type-01__').include?('set_root') }
check('definition name mismatch') { CONV.Na__ComponentEditorTools__CheckAsset('13_2023__Pot__Type-04__', '13__Building__Roof/13_2000__ChimneyPots', definition_name: '13_2023__Pot__Type-04')['issues'].any? { |i| i['rule'] == 'definition_name' } }
check('suggested fix: prefix, typo, underscores') do
    CONV.Na__ComponentEditorTools__CheckAsset('27_22__OudoorLiving__Sink__Type-01____', '17__Building__Fixtures/17_4000__Bathroom')['suggested_name'].nil? &&
        CONV.Na__ComponentEditorTools__CheckAsset('27_4003__Oudoor__Toilet__Type-03', '17__Building__Fixtures/17_4000__Bathroom')['suggested_name'] == '17_4003__Outdoor__Toilet__Type-03__'
end
check('series ranges') { CONV.Na__ComponentEditorTools__SeriesRange(2000) == [2000, 2999] && CONV.Na__ComponentEditorTools__SeriesRange(2010) == [2010, 2019] && CONV.Na__ComponentEditorTools__SeriesRange(2200) == [2200, 2299] && CONV.Na__ComponentEditorTools__SeriesRange(1005) == [1000, 1999] && CONV.Na__ComponentEditorTools__SeriesRange(0) == [0, 999] }
check('family ranges') { CONV.Na__ComponentEditorTools__FamilyRange('13_20') == [2000, 2099] && CONV.Na__ComponentEditorTools__FamilyRange('202') == [2020, 2029] && CONV.Na__ComponentEditorTools__FamilyRange('60_03') == [300, 399] }
check('next numbers skip used and x0') { CONV.Na__ComponentEditorTools__NextNumbers([2021, 2022, 2023, 2025, 2026, 2029], 2000, 2999, 2) == [2031, 2032] }
check('first number in empty range') { CONV.Na__ComponentEditorTools__NextNumbers([], 5000, 5999, 1) == [5001] }
check('build stem') { CONV.Na__ComponentEditorTools__BuildStem('13_5002', '13_5002__Roof__RidgeFinial__Type-02.skp') == '13_5002__Roof__RidgeFinial__Type-02__' }
