{
  "meta": {
    "file": "Na__ComponentEditorTools__LibraryConvention__.json",
    "purpose": "The naming and numbering rules for Adam's component library. Read by 12__McpOperations (the agent library tools) to check names, allocate codes and fill blank library data. Edit here; the Ruby reads it on every call.",
    "schema_version": 1,
    "updated": "30-Sep-2026"
  },
  "default_set": "Na__CoreLib__3dAssets",
  "journal_folder": "00__Archive/00__McpLibraryJournals",
  "holding_folders": {
    "archive": "00__Archive",
    "to_sort": "85__ToSort",
    "work_in_progress": "95__TEMP__Ripdown"
  },
  "unfiled_prefixes": ["85__", "86__", "95__", "TEMP__", "RIPDOWN__", "VALIDATE__"],
  "archive_date_suffix": "__%d-%b-%Y",
  "archive_rule": "Archiving an asset zips it into its set's 00__Archive as <name>__30-Sep-2026.zip (Adam, 30-Sep-2026). The zip is read back and checked before the original leaves the library.",
  "rules": {
    "code": "NN_NNNN: NN = the category folder number, NNNN = the asset number. Four digits, unique within a library set.",
    "category_folder": "NN__Domain__Category, e.g. 13__Building__Roof. NN mirrors the SSOT tag numbers (existing-building numbers 11-19 for building elements).",
    "series_folder": "NN_S000__SeriesName inside a category, e.g. 13_2000__ChimneyPots. Its files take codes in the same thousand (13_2001-13_2999). Codes ending in 0 are kept for folder bases.",
    "flat_category": "A category without series folders numbers in hundreds families: 60_03xx men and women, 60_05xx animals.",
    "file_name": "NN_NNNN__Series__Item__Descriptor__Type-01__Size__.skp. Double underscores between PascalCase segments, hyphens inside a segment, and always a trailing __ before .skp.",
    "definition_name": "The component definition inside the file is named exactly like the file, without .skp.",
    "unfiled": "85__ (to sort), 95__TEMP__ / RIPDOWN__ (work in progress) and TEMP__ are unfiled. NN_NNNN__ (letters N) marks a number not yet allocated."
  },
  "allowed_segment_pattern": "^[A-Za-z0-9.&()+-]+(?:_[A-Za-z0-9.&()+-]+)*$",
  "word_fixes": {
    "Oudoor": "Outdoor",
    "Inudction": "Induction",
    "WallHuing": "WallHung",
    "Commisions": "Commissions",
    "Coted": "Coated"
  },
  "categories": {
    "08": { "folder": "08__Site__Boundaries",      "tag": "08__Site__Boundaries",      "taxonomy": ["Environment", "Site Boundary"] },
    "09": { "folder": "09__Site__Vegetation__2D",  "tag": "09__Site__Vegetation__2D",  "taxonomy": ["Environment", "Site Vegetation 2D"] },
    "11": { "folder": "11__Building__Masonry",     "tag_existing": "11__ExistingBuilding__Walls",         "tag_proposed": "21__ProposedBuilding__Walls",         "taxonomy": ["Building", ""] },
    "12": { "folder": "12__Building__Floors",      "tag_existing": "12__ExistingBuilding__Floors",        "tag_proposed": "22__ProposedBuilding__Floors",        "taxonomy": ["Building", "Floor"] },
    "13": { "folder": "13__Building__Roof",        "tag_existing": "13__ExistingBuilding__Roofs",         "tag_proposed": "23__ProposedBuilding__Roofs",         "taxonomy": ["Building", "Roof"] },
    "14": { "folder": "14__Building__Windows",     "tag_existing": "14__ExistingBuilding__Windows",       "tag_proposed": "24__ProposedBuilding__Windows",       "taxonomy": ["Building", "Window"] },
    "15": { "folder": "15__Building__Doors",       "tag_existing": "15__ExistingBuilding__Doors",         "tag_proposed": "25__ProposedBuilding__Doors",         "taxonomy": ["Building", "Door"] },
