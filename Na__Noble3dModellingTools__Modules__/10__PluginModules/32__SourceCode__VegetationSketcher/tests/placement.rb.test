# Placement variation: range validation, rolls, world matrices and the
# acknowledged dialog/tool path. Native instance display needs SketchUp.
Placement = Na__Noble3dModellingTools::Na__VegetationSketcher__Placement
defaults = Placement.Na__VegetationSketcher__Placement__Resolve({})
check('placement defaults resolve and round trip') { defaults == Placement::NA_DEFAULTS && Placement.Na__VegetationSketcher__Placement__Resolve(JSON.generate(defaults)) == defaults }
rejected('size below range refused, not clamped') { Placement.Na__VegetationSketcher__Placement__Resolve('scale_min' => 5) }
rejected('lean above range refused') { Placement.Na__VegetationSketcher__Placement__Resolve('lean' => 40) }
rejected('non-numeric range refused') { Placement.Na__VegetationSketcher__Placement__Resolve('rotation' => 'bad') }
rejected('NaN range refused') { Placement.Na__VegetationSketcher__Placement__Resolve('height_max' => Float::NAN) }
rejected('minimum size above maximum refused') { Placement.Na__VegetationSketcher__Placement__Resolve('scale_min' => 120, 'scale_max' => 110) }
rejected('minimum stretch above maximum refused') { Placement.Na__VegetationSketcher__Placement__Resolve('height_min' => 130) }
message = begin; Placement.Na__VegetationSketcher__Placement__Resolve('scale_max' => 900); rescue ArgumentError => e; e.message; end
check('refusal names the field and its range') { message == 'Maximum size must be 10 to 500%.' }
check('damaged stored preferences fall back to defaults') { Placement.Na__VegetationSketcher__Placement__Load('{bad') == Placement::NA_DEFAULTS && Placement.Na__VegetationSketcher__Placement__Load(nil) == Placement::NA_DEFAULTS }
check('disabled placement is the identity roll') { Placement.Na__VegetationSketcher__Placement__Roll(defaults.merge('enabled' => false)) == Placement::NA_IDENTITY_ROLL }

wide = Placement.Na__VegetationSketcher__Placement__Resolve('scale_min' => 60, 'scale_max' => 140, 'height_min' => 80, 'height_max' => 120, 'rotation' => 90, 'lean' => 8)
random = Random.new(4)
rolls = Array.new(400) { Placement.Na__VegetationSketcher__Placement__Roll(wide, random) }
check('size rolls stay inside the range and use it') { rolls.all? { |r| r['scale'].between?(0.6, 1.4) } && rolls.map { |r| r['scale'] }.minmax.then { |a, b| a < 0.65 && b > 1.35 } }
check('height stretch rolls stay inside the range') { rolls.all? { |r| r['height'].between?(0.8, 1.2) } }
check('turn and lean respect their maxima') { rolls.all? { |r| r['yaw'].between?(0, Math::PI / 2) && r['lean'].between?(0, 8 * Math::PI / 180) } }
check('a seeded roll repeats') { Placement.Na__VegetationSketcher__Placement__Roll(wide, Random.new(9)) == Placement.Na__VegetationSketcher__Placement__Roll(wide, Random.new(9)) }

def columns(m); [m[0, 3], m[4, 3], m[8, 3], m[12, 3]]; end
def dot(a, b); a.zip(b).sum { |x, y| x * y }; end
def len(a); Math.sqrt(dot(a, a)); end
point = [120.0, -45.0, 30.0]
identity = columns(Placement.Na__VegetationSketcher__Placement__Matrix(point, Placement::NA_IDENTITY_ROLL))
check('identity roll is a pure translation') { identity == [[1, 0, 0], [0, 1, 0], [0, 0, 1], point] }
matrices = rolls.map { |roll| [roll, Placement.Na__VegetationSketcher__Placement__Matrix(point, roll)] }
check('every roll keeps the base on the picked point') { matrices.all? { |_, m| m[12, 3] == point && m[3] == 0 && m[7] == 0 && m[11] == 0 && m[15] == 1 } }
check('every roll sizes and stretches without skew') do
  matrices.all? do |roll, m|
    x, y, z = columns(m)
    (len(x) - roll['scale']).abs < 1e-9 && (len(y) - roll['scale']).abs < 1e-9 &&
      (len(z) - roll['scale'] * roll['height']).abs < 1e-9 && dot(x, y).abs < 1e-9 && dot(x, z).abs < 1e-9 && dot(y, z).abs < 1e-9
  end
end
check('every roll leans the trunk by exactly its rolled angle') { matrices.all? { |roll, m| z = m[8, 3]; (Math.acos(z[2] / len(z)) - roll['lean']).abs < 1e-9 } }
upright = columns(Placement.Na__VegetationSketcher__Placement__Matrix(point, { 'scale' => 1.1, 'height' => 1.0, 'yaw' => Math::PI / 2, 'lean' => 0.0, 'lean_dir' => 0.0 }))
check('turn rotates red toward green about the vertical') { upright[0].map { |v| v.round(9) } == [0.0, 1.1, 0.0] && upright[2] == [0.0, 0.0, 1.1] }
check('describe summarises the roll') do
  Placement.Na__VegetationSketcher__Placement__Describe({ 'scale' => 1.04, 'height' => 0.98, 'yaw' => Math::PI, 'lean' => 2 * Math::PI / 180, 'lean_dir' => 0 }) == '104% size, 98% height, 180° turn, 2.0° lean' &&
    Placement.Na__VegetationSketcher__Placement__Describe(Placement::NA_IDENTITY_ROLL) == '100% size'
end

# Dialog and tool: ranges travel on their own command and reach each commit.
Builder.singleton_class.alias_method(:placement_native_create, :Na__VegetationSketcher__Builder__Create)
created_transforms = []
Builder.define_singleton_method(:Na__VegetationSketcher__Builder__Create) do |model, options, transform, _length = nil|
  created_transforms << transform
  entity = Sketchup::ComponentInstance.new(900 + created_transforms.length)
  DataSerializer.Na__VegetationSketcher__DataSerializer__Save(model, entity, options, 1)
  model.active_entities << entity
  entity
end
model = Sketchup::Model.new
Sketchup.model = model
view = TestView.new
model.view = view
dialog = Dialog.Na__VegetationSketcher__ShowDialog
dialog.callbacks['na_dialog_ready'].call(nil)
state = dialog.events.reverse.find { |event, _| event == 'state' }[1]
check('state carries placement ranges and limits') { state['placement'] == JSON.parse(JSON.generate(Dialog.na_placement)) && state['placement_limits']['lean'] == [0, 30] }
Dialog.na_dispatch('preset', { 'preset' => 'shrub' })
dialog.callbacks['na_event'].call(nil, JSON.generate(id: 71, session: state['session'], revision: 1, action: 'placement', payload: { context: -5, target_id: 'stale', placement: wide }))
check('placement is accepted whatever the selection context') { dialog.events.last == ['ack', { 'id' => 71, 'success' => true }] && Dialog.na_placement == wide }
dialog.callbacks['na_event'].call(nil, JSON.generate(id: 72, session: state['session'], revision: 2, action: 'placement', payload: { placement: wide.merge('scale_min' => 200) }))
check('an inverted size range is refused and the saved ranges kept') { dialog.events.last == ['ack', { 'id' => 72, 'success' => false }] && Dialog.na_placement == wide }
state = dialog.events.reverse.find { |event, _| event == 'state' }[1]
Dialog.na_dispatch('start', { 'settings' => state['settings'], 'placement' => wide })
tool = model.instance_variable_get(:@tool)
check('plant tool receives the ranges') { tool.instance_variable_get(:@na_placement) == wide }
3.times do |i|
  tool.onLButtonDown(0, 1000 + i * 700, 2000, view)
  tool.onLButtonUp(0, 1000 + i * 700, 2000, view)
end
matrices = created_transforms.map(&:offset)
check('each click creates a varied world matrix') { matrices.length == 3 && matrices.all? { |m| m.length == 16 } && matrices.uniq.length == 3 }
check('created plants sit on their picked points') { matrices.each_with_index.all? { |m, i| m[12, 3].map { |v| (v * 25.4).round(6) } == [1000.0 + i * 700, 2000.0, 0.0] } }
check('created sizes stay in range') { matrices.all? { |m| len(m[0, 3]).between?(0.6, 1.4) } }
check('status shows the next roll') { Sketchup.status_text.include?('Next: ') }
before = tool.instance_variable_get(:@na_roll)
tool.onKeyDown(82, false, 0, view)
check('R rolls placement again with the form') { tool.instance_variable_get(:@na_roll) != before }
Dialog.na_dispatch('placement', { 'placement' => wide.merge('enabled' => false) })
tool.onLButtonDown(0, 5000, 2000, view)
tool.onLButtonUp(0, 5000, 2000, view)
check('switching variation off mid-placement plants at the exact size') { created_transforms.last.offset == [5000.0 / 25.4, 2000.0 / 25.4, 0.0] }
check('the base size in saved settings never drifts') { created_transforms.length == 4 && model.active_entities.map { |e| DataSerializer.Na__VegetationSketcher__DataSerializer__Load(e)['width'] }.uniq.length == 1 }
Dialog.na_dispatch('preset', { 'preset' => 'hedge' })
Dialog.Na__VegetationSketcher__ResetDialog
UI.flush
Builder.singleton_class.alias_method(:Na__VegetationSketcher__Builder__Create, :placement_native_create)
puts "PASS: #{$checks} total Ruby checks including placement variation."
