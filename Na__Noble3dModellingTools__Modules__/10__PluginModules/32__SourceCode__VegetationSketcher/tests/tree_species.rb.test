# Loaded after the shared regression and Tool contract doubles.
fixtures = JSON.parse(File.read(File.join(__dir__, 'fixtures.json')))
fixtures['tree_types'] = V::Options.tree_type_info

def bounds_of(points)
  3.times.map { |axis| points.map { |p| p[axis] }.minmax }
end

check('legacy tree options remain generic') { V::Options.resolve('preset' => 'tree')['tree_type'] == 'generic' }
check('unknown saved species falls back to generic') { V::Options.resolve('preset' => 'tree', 'tree_type' => 'missing')['tree_type'] == 'generic' }
rejected('unknown species choice rejected') { V::Options.tree_preset('missing') }

%w[douglas_fir english_oak].each do |type|
  options = V::Options.resolve('preset' => 'tree', 'tree_type' => type)
  check("#{type}: preset loads usable full-size defaults") { options == V::Options.tree_preset(type) && options['height'] >= 18000 }
  mesh = V::Mesh.build(options)
  check("#{type}: final density under limit") { mesh[:requested_quads] == mesh[:quads].length && mesh[:quads].length < V::Mesh::MAX_QUADS }
  preview = V::Mesh.build(options, preview: true)
  check("#{type}: bounded preview") { preview[:quads].length <= V::Mesh::PREVIEW_QUADS }
  edges = Hash.new(0)
  mesh[:quads].each { |q| q.each_with_index { |a, i| edges[[a, q[(i + 1) % 4]].sort] += 1 } }
  check("#{type}: single welded closed crown") { edges.values.all? { |n| n == 2 } && mesh[:points].length - edges.length + mesh[:quads].length == 2 }
  check("#{type}: no sub-tolerance crown edges") do
    edges.keys.all? { |a, b| Math.sqrt(3.times.sum { |k| (mesh[:points][a][k] - mesh[:points][b][k])**2 }) > 0.05 }
  end
  check("#{type}: nondegenerate crown triangles") do
    mesh[:quads].all? do |a, b, c, d|
      [[a,b,c], [a,c,d]].all? do |i,j,k|
        u = 3.times.map { |axis| mesh[:points][j][axis] - mesh[:points][i][axis] }
        v = 3.times.map { |axis| mesh[:points][k][axis] - mesh[:points][i][axis] }
        V::TreeForms.cross(u, v).sum { |n| n*n } > 0.0001
      end
    end
  end
  [mesh, preview].each_with_index do |data, i|
    box = bounds_of(data[:points] + data[:trunk][:points])
    check("#{type}: #{i == 0 ? 'final' : 'preview'} millimetre bounds match requested scale") do
      [options['width'], options['depth'], options['height']].each_with_index.all? { |n, axis| (box[axis][1] - box[axis][0] - n).abs < 1.0e-6 } && box[2][0].zero?
    end
    check("#{type}: foliage starts at entered crown base") { (data[:points].map(&:last).min - options['trunk_height']).abs < 1.0e-6 }
  end
  check("#{type}: seed reproduces geometry") { mesh[:points] == V::Mesh.build(options)[:points] }
  varied = V::Mesh.build(options.merge('seed' => 9231))
  check("#{type}: variation changes shape at fixed dimensions") { mesh[:points] != varied[:points] && bounds_of(mesh[:points]) == bounds_of(varied[:points]) }
  smaller = options.merge('width' => 6000, 'depth' => 5000, 'height' => 9000, 'trunk_height' => 1800)
  check("#{type}: custom tree dimensions remain editable") { (bounds_of(V::Mesh.build(smaller)[:points])[2][1] - 9000).abs < 1.0e-6 }
  entity = Sketchup::ComponentInstance.new(180)
  model = Sketchup::Model.new
  V::DataSerializer.save(model, entity, options, mesh[:quads].length)
  check("#{type}: definition and model defaults retain species and scale") { V::DataSerializer.load(entity) == options && V::DataSerializer.model_options(model, '{}') == options }
  copy = Sketchup::ComponentInstance.new(181, entity.definition)
  check("#{type}: copied definition retains species") { V::DataSerializer.load(copy)['tree_type'] == type }
  fixtures[type] = { settings: options, mesh: preview }
end
check('fir has a narrower upper crown than lower crown') do
  p = fixtures['douglas_fir'][:mesh][:points]
  lower = p.select { |v| v[2] > 2500 && v[2] < 6000 }.map { |v| v[0].abs }.max
  upper = p.select { |v| v[2] > 14000 }.map { |v| v[0].abs }.max
  upper < lower * 0.4
end
check('oak has scaffold limbs beyond the main bole') do
  p = fixtures['english_oak'][:mesh][:trunk][:points]
  p.map { |v| Math.hypot(v[0],v[1]) }.max > 4500
end
File.write(File.join(__dir__, 'fixtures.json'), JSON.generate(fixtures))

# Real acknowledged controller and Tool events; only native population is doubled.
V::Builder.singleton_class.alias_method(:species_native_create, :create)
V::Builder.singleton_class.alias_method(:species_native_update, :update)
V::Builder.define_singleton_method(:create) do |model, options, _transform, _length = nil|
  data = V::Mesh.build(options)
  entity = Sketchup::ComponentInstance.new(200 + model.active_entities.length)
  entity.name = 'Noble Whitecard ' + V::Options.label(options)
  V::DataSerializer.save(model, entity, options, data[:quads].length)
  model.active_entities << entity
  entity
end
V::Builder.define_singleton_method(:update) do |model, entity, options|
  data = V::Mesh.build(options)
  V::DataSerializer.save(model, entity, options, data[:quads].length)
end
model = Sketchup::Model.new
Sketchup.model = model
view = TestView.new
model.view = view
dialog = V::Dialog.show
dialog.callbacks['na_ready'].call(nil)
V::Dialog.dispatch('preset', { 'preset' => 'tree' })
state = dialog.events.reverse.find { |event, _| event == 'state' }[1]
payload = { 'context' => state['context'], 'target_id' => state['target_id'], 'tree_type' => 'douglas_fir' }
dialog.callbacks['na_event'].call(nil, JSON.generate(id: 44, session: state['session'], revision: 1, action: 'tree_type', payload: payload))
check('species command acknowledged with correct dimensions') do
  settings = dialog.events.reverse.find { |event, _| event == 'state' }[1]['settings']
  settings['tree_type'] == 'douglas_fir' && settings['height'] == 18000 && dialog.events.last == ['ack', { 'id' => 44, 'success' => true }]
end
settings = dialog.events.reverse.find { |event, _| event == 'state' }[1]['settings']
V::Dialog.dispatch('start', { 'settings' => settings })
tool = model.instance_variable_get(:@tool)
tool.onLButtonDown(0, 1200, 2400, view)
tool.onLButtonUp(0, 1200, 2400, view)
created = model.selection.first
check('plant tool creates chosen species') { created && V::DataSerializer.load(created)['tree_type'] == 'douglas_fir' }
V::Dialog.dispatch('stop', {})
state = dialog.events.reverse.find { |event, _| event == 'state' }[1]
check('Finish reloads planted species into editor') { state['target_id'] == created.persistent_id.to_s && state['settings']['tree_type'] == 'douglas_fir' }
edit = { 'context' => state['context'], 'target_id' => state['target_id'], 'tree_type' => 'english_oak' }
V::Dialog.dispatch('tree_type', edit)
check('live species edit updates same selected tree') { model.active_entities.length == 1 && V::DataSerializer.load(created)['tree_type'] == 'english_oak' }
V::Dialog.dispatch('live', edit.merge('enabled' => false))
V::Dialog.dispatch('tree_type', edit.merge('tree_type' => 'douglas_fir'))
check('paused live editing preserves saved species') { V::DataSerializer.load(created)['tree_type'] == 'english_oak' }
state = dialog.events.reverse.find { |event, _| event == 'state' }[1]
V::Dialog.dispatch('update', edit.merge('settings' => state['settings']))
check('manual Update saves staged species') { V::DataSerializer.load(created)['tree_type'] == 'douglas_fir' }
V::Dialog.dispatch('new', {})
rejected('stale species edit cannot affect previous selection') { V::Dialog.dispatch('tree_type', edit) }
V::Dialog.reset
UI.flush
V::Builder.singleton_class.alias_method(:create, :species_native_create)
V::Builder.singleton_class.alias_method(:update, :species_native_update)
puts "PASS: #{$checks} total Ruby checks including species scale, topology, persistence and planting."
