saved = AO::Na__ConfigStore.Na__Config__SaveSettings('tracking' => { 'keep_days' => '14', 'bogus' => 1 }, 'nope' => { 'x' => 1 }, 'grading' => { 'agent_colour' => 'purple' })
check('settings: coerced to the default\'s type', saved['tracking']['keep_days'] == 14)
user_file = JSON.parse(File.read(AO::Na__ConfigStore.Na__Config__UserConfigPath))
check('settings: unknown keys and a bad colour are dropped', !user_file['settings']['tracking'].key?('bogus') && !user_file['settings'].key?('nope') && !user_file['settings'].key?('grading'))
AO::Na__ConfigStore.Na__Config__SaveSettings('tracking' => { 'keep_days' => 30 })
user_file = JSON.parse(File.read(AO::Na__ConfigStore.Na__Config__UserConfigPath))
check('settings: a value equal to its default is not stored', !(user_file['settings']['tracking'] || {}).key?('keep_days'))
_std, issues = AO::Na__ConfigStore.Na__Standards__Validate('prefixes' => [{ 'label' => 'Bad Label' }, { 'label' => 'OK__One' }, { 'label' => 'ok__one' }], 'flags' => [{ 'id' => 'Bad Id', 'label' => 'x' }])
check('standards: bad labels, duplicates and bad flag ids are named', issues.length == 4)
saved_std, issues = AO::Na__ConfigStore.Na__Standards__Save('prefixes' => prefixes + [{ 'label' => 'CAD__GroundFloorPlan', 'category' => 'CAD Plans', 'mode' => 'replace', 'colour' => '#123456', 'meaning' => 'The ground floor plan CAD.' }],
                                                            'flags' => AO::Na__ConfigStore.Na__Standards__Flags, 'handoff' => { 'footer' => 'Answer in the thread.' })
check('standards: save adds a prefix', issues.empty? && saved_std['prefixes'].any? { |p| p['label'] == 'CAD__GroundFloorPlan' })
written = File.read(AO::Na__ConfigStore.Na__Config__StandardsPath)
check('standards: written in the aligned house layout, with a .bak', written.include?('"label"    : "CAD__GroundFloorPlan"') && File.exist?("#{AO::Na__ConfigStore.Na__Config__StandardsPath}.bak"))
check('standards: the plugin\'s own file was not touched', !File.read(File.join($NA_MODULES_ROOT, '02__AppData', 'Na__AgentOutliner__AppData__NamingStandards__.json')).include?('CAD__GroundFloorPlan'))

# A definition added and erased in one operation arrives deleted, and SketchUp raises on any call to it (0.1.7)
gone = Sketchup::ComponentDefinition.new('Gone')
gone.na_kill!
gone.define_singleton_method(:image?) { raise TypeError, 'reference to deleted ComponentDefinition' }
errors_before = (AO::Na__Observers.instance_variable_get(:@na_error_counts) || {})['onComponentAdded'].to_i
AO::Na__Observers::DefinitionsWatch.new.onComponentAdded($NA_MODEL.definitions, gone)
errors_after = (AO::Na__Observers.instance_variable_get(:@na_error_counts) || {})['onComponentAdded'].to_i
check('observers: a definition that arrives deleted is skipped, no error logged', errors_after == errors_before)

# ---------------------------------------------------------------------------
# 0.1.11: watches on erased definitions, and who undid
# ---------------------------------------------------------------------------
# Live in the Assembly Studio testbed (11-Nov-2026): 179 of 490 watched Entities belonged to definitions
# erased later (undone builds), and an agent's undo and redo were Adam's for two minutes (a stale held answer).
obs_mod  = AO::Na__Observers
ao_watch = obs_mod.na_watch_for(model)
watched_before = ao_watch[:watched].length
doomed = model.definitions.na_add(Sketchup::ComponentDefinition.new('Doomed'))
dead_ents = doomed.entities
check('prune: a new definition is watched', ao_watch[:watched].length == watched_before + 1 && dead_ents.observers.include?(ao_watch[:ents_obs]))
model.definitions.na_erase(doomed)
check('prune: an erased definition\'s entities raise like SketchUp\'s', (begin; dead_ents.parent; false; rescue TypeError; true; end))
dropped = obs_mod.Na__Observers__Prune(model)
check('prune: drops the erased definition\'s watch and keeps every live one',
      dropped == 1 && ao_watch[:watched].length == watched_before && ao_watch[:watched].none? { |e| e.equal?(dead_ents) } && !ao_watch[:watched_ids].key?(dead_ents.object_id))
check('prune: a second run finds nothing, and a model not watched gives 0', obs_mod.Na__Observers__Prune(model).zero? && obs_mod.Na__Observers__Prune(Object.new).zero?)

doomed = model.definitions.na_add(Sketchup::ComponentDefinition.new('Doomed 2'))
dead_ents = doomed.entities
model.definitions.na_erase(doomed)
AO::Na__Tracker.Na__Tracker__OnFullNeeded(model)
UI.run_timers!
check('prune: the tracker\'s full pass drops it too', ao_watch[:watched].length == watched_before && ao_watch[:watched].none? { |e| e.equal?(dead_ents) })

doomed = model.definitions.na_add(Sketchup::ComponentDefinition.new('Doomed 3'))
model.definitions.na_erase(doomed)
live_def = model.definitions.find { |d| d.valid? && d.entities.observers.include?(ao_watch[:ents_obs]) }
warned = []
dbg = AO::Na__DebugTools
dbg.singleton_class.send(:alias_method, :na_test_warn, :Na__Debug__Warn)
dbg.define_singleton_method(:Na__Debug__Warn) { |text| warned << text; na_test_warn(text) }
begin
    obs_mod.Na__Observers__Detach(model)
ensure
    dbg.singleton_class.send(:alias_method, :Na__Debug__Warn, :na_test_warn)
end
check('detach: an erased definition\'s watch is skipped, with no warning', warned.none? { |text| text.include?('Releasing an observer') })
check('detach: every live watch is let go', live_def && !live_def.entities.observers.include?(ao_watch[:ents_obs]) && !model.entities.observers.include?(ao_watch[:ents_obs]))
obs_mod.Na__Observers__Attach(model)
UI.run_timers!

eval(<<~RUBY, TOPLEVEL_BINDING, 'C:/Plugins/Na__SketchUpMcp__Modules__/10__BridgeHandlers/Na__SketchUpMcp__Handlers__Actions__.rb', 1)
    module FakeMcpUndo
        # As traced live: the undo's own notice first, then the entity events it raises, all inside the call.
        def self.Na__Handlers__Actions__Undo(model, entity, again: false)
            if again
                model.na_fire_redo
                entity.na_revive!
                model.entities.observers.each { |o| o.onElementAdded(model.entities, entity) }
            else
                model.na_fire_undo
                model.entities.na_remove(entity)
            end
        end
        def self.Na__Handlers__Actions__Current
            Na__AgentOutliner::Na__ActorDetect.Na__Actor__Current
        end
    end
RUBY
ad = AO::Na__ActorDetect
model.start_operation('Draw Victim', true)
victim = na_group(model.entities, 'SUB__UndoVictim')
model.commit_operation
UI.run_timers!
held_user  = { 'by' => 'user', 'tool' => nil }
held_agent = { 'by' => 'agent', 'tool' => 'Primitives__CreateSolid' }
hold_stale = lambda do |answer|
    ad.instance_variable_set(:@na_transaction, answer)                                  # <-- An operation's answer never let go
    ad.instance_variable_set(:@na_tick, answer)                                         # <-- And a tick answer that looks fresh
    ad.instance_variable_set(:@na_tick_at, ad.na_clock)
end
victim_last = lambda { |seq| AO::Na__Tracker.Na__Tracker__Events(model, since_seq: seq).select { |e| e['pid'] == victim.persistent_id }.last }

seq = AO::Na__Tracker.Na__Tracker__Seq(model)
hold_stale.call(held_user)
FakeMcpUndo.Na__Handlers__Actions__Undo(model, victim)
UI.run_timers!
gone = victim_last.call(seq)
check('undo credit: an agent\'s undo is the agent\'s, though Adam\'s answer was held',
      gone && gone['kind'] == 'removed' && gone['by'] == 'agent' && gone['tool'] == 'Actions__Undo' && gone['via'] == 'undo')

seq = AO::Na__Tracker.Na__Tracker__Seq(model)
hold_stale.call(held_user)
FakeMcpUndo.Na__Handlers__Actions__Undo(model, victim, again: true)
UI.run_timers!
back = victim_last.call(seq)
check('redo credit: and its redo is the agent\'s too', back && back['kind'] == 'new' && back['by'] == 'agent' && back['via'] == 'redo')

seq = AO::Na__Tracker.Na__Tracker__Seq(model)
hold_stale.call(held_agent)
model.na_fire_undo                                                                      # <-- Adam's Ctrl+Z: no MCP on the stack
model.entities.na_remove(victim)
UI.run_timers!
mine = victim_last.call(seq)
check('undo credit: Adam\'s Ctrl+Z is his, though an agent\'s answer was held', mine && mine['kind'] == 'removed' && mine['by'] == 'user' && mine['via'] == 'undo')

ad.instance_variable_set(:@na_transaction, nil)
ad.instance_variable_set(:@na_tick, held_user)
ad.instance_variable_set(:@na_tick_at, ad.na_clock - 5.0)                               # <-- Read five seconds ago
ad.instance_variable_set(:@na_tick_timer, true)                                         # <-- And its clearing timer lost
ad.instance_variable_set(:@na_tick_timer_at, ad.na_clock - 5.0)
timers_before = $NA_TIMERS.length
fresh = FakeMcpUndo.Na__Handlers__Actions__Current
check('tick: an answer held past NA_TICK_MAX_S is read again', fresh['by'] == 'agent' && fresh['tool'] == 'Actions__Current')
check('tick: a clearing timer lost for seconds is booked again', $NA_TIMERS.length == timers_before + 1)
UI.run_timers!
check('tick: and the answer is let go once it runs', ad.instance_variable_get(:@na_tick).nil? && ad.instance_variable_get(:@na_tick_timer) == false)

# ---------------------------------------------------------------------------
# Reasoning effort on Adam's messages (0.1.14): a dispatcher session applies it
# ---------------------------------------------------------------------------
OPS.Na__AgentOutliner__McpEdit('acknowledge', {})
check('effort: Auto and blank are none; the five levels are kept in any case; anything else is refused, naming them',
      NOTES.Na__Notes__Effort('auto').nil? && NOTES.Na__Notes__Effort('').nil? && NOTES.Na__Notes__Effort(nil).nil? &&
      %w[low medium high xhigh max].all? { |level| NOTES.Na__Notes__Effort(level.upcase) == level } &&
      (begin; NOTES.Na__Notes__Effort('ultra'); false; rescue ArgumentError => e; e.message.include?('xhigh'); end))

effort_statuses = []
dm3 = AO::Na__DialogManager
dm3.singleton_class.send(:alias_method, :na_test_send3, :Na__Dialog__Send)
dm3.define_singleton_method(:Na__Dialog__Send) { |channel, payload| effort_statuses << payload if channel == 'status'; true }
ad3 = AO::Na__ActorDetect
ad3.singleton_class.send(:alias_method, :na_test_mcp3, :Na__Actor__McpStatus)
ad3.define_singleton_method(:Na__Actor__McpStatus) { { 'running' => true, 'version' => '1.0.28', 'last' => { 'time' => Time.now.strftime('%H:%M:%S'), 'tool' => 'model_info' } } }
history_dir = AO::Na__HistoryStore.Na__History__Folder
FileUtils.mkdir_p(history_dir)
dispatcher_file = File.join(history_dir, 'Watch__9.json').sub('Watch__9', 'Dispatch__4201')
begin
    File.delete(dispatcher_file) if File.exist?(dispatcher_file)
    AO::Na__ActionRouter.Na__Action__Dispatch('comment', { 'model' => true, 'text' => 'Rebuild the lanterns to the new footprint.', 'chat' => true, 'effort' => 'max' })
    last_entry = NOTES.Na__Notes__Read(model)['thread']['entries'].last
    check('effort: the comment carries the effort Adam picked', last_entry['text'] == 'Rebuild the lanterns to the new footprint.' && last_entry['effort'] == 'max')
    notice = OPS.Na__AgentOutliner__McpNotice(model)
    check('effort: the waiting notice carries it', notice && notice['effort'] == 'max')
    signal_data = JSON.parse(File.read(AO::Na__HistoryStore.Na__History__InboxPath(AO::Na__HistoryStore.Na__History__KeyFor(model))))
    check('effort: so does the inbox signal a dispatcher checks requests against', signal_data['notice']['effort'] == 'max')
    inbox_now = OPS.Na__AgentOutliner__McpRead('inbox', {})
    check('effort: an agent reading the inbox sees it on the entry', inbox_now['model_thread']['entries'].last['effort'] == 'max')
    check('effort: with no dispatcher running, Send says Max is not applied (amber)',
          effort_statuses.last['level'] == 'warn' && effort_statuses.last['message'].end_with?('Max effort is not applied: no dispatcher is running (ask Claude to run the Outliner dispatcher).'))

    File.write(dispatcher_file, JSON.generate('pid' => 4201, 'who' => 'Claude (dispatcher)', 'beat' => Time.now.to_f - 100, 'busy' => true))
    check('dispatchers: one working a request (100 s since its beat) still counts', AO::Na__HistoryStore.Na__History__Dispatchers.map { |d| d['pid'] } == [4201])
    AO::Na__ActionRouter.Na__Action__Dispatch('comment', { 'model' => true, 'text' => 'Quick one.', 'effort' => 'low' })
    check('effort: with a dispatcher, Send says it sets the effort for each agent it wakes',
          effort_statuses.last['level'] == 'success' && effort_statuses.last['message'].end_with?('The dispatcher sets Low effort for each agent it wakes.'))
    File.write(dispatcher_file, JSON.generate('pid' => 4201, 'who' => 'Claude (dispatcher)', 'beat' => Time.now.to_f - 400))
    check('dispatchers: one silent for over three minutes is gone', AO::Na__HistoryStore.Na__History__Dispatchers.empty?)

    count_before = NOTES.Na__Notes__Read(model)['thread']['entries'].length
    AO::Na__ActionRouter.Na__Action__Dispatch('comment', { 'model' => true, 'text' => 'Typo effort.', 'effort' => 'ultra' })
    check('effort: an unknown effort is refused and nothing is written', NOTES.Na__Notes__Read(model)['thread']['entries'].length == count_before &&
          effort_statuses.last['level'] == 'warn' && effort_statuses.last['message'].include?('Reasoning effort'))
    AO::Na__ActionRouter.Na__Action__Dispatch('comment', { 'model' => true, 'text' => 'No effort here.', 'effort' => 'auto' })
    check('effort: Auto stores none, and the notice has none', !NOTES.Na__Notes__Read(model)['thread']['entries'].last.key?('effort') &&
          !OPS.Na__AgentOutliner__McpNotice(model).key?('effort'))
ensure
    File.delete(dispatcher_file) if File.exist?(dispatcher_file)
    dm3.singleton_class.send(:alias_method, :Na__Dialog__Send, :na_test_send3)
    ad3.singleton_class.send(:alias_method, :Na__Actor__McpStatus, :na_test_mcp3)
end
OPS.Na__AgentOutliner__McpEdit('acknowledge', {})

# ---------------------------------------------------------------------------
# 0.1.15: the dialog's icons, the selection backstop and the two switches
# ---------------------------------------------------------------------------
dm4 = AO::Na__DialogManager
icons = dm4.na_icon_set
check('icons: every SVG in UiIcons__DialogIcons__AgentOutliner is read, keyed by its short name',
      icons.length >= 25 && %w[Flag Tag QuickName FollowSelection StatusColours PanelClose].all? { |name| icons[name].to_s.start_with?('<svg') })
check('icons: the keys carry neither the Icon__AgentOutliner__ prefix nor the closing __',
      icons.keys.none? { |name| name.start_with?('Icon__') || name.end_with?('_') })

sent4 = []
dm4.singleton_class.send(:alias_method, :na_test_send4, :Na__Dialog__Send)
dm4.singleton_class.send(:alias_method, :na_test_visible4, :Na__Dialog__Visible?)
dm4.singleton_class.send(:alias_method, :na_test_showing4, :na_showing?)
dm4.define_singleton_method(:Na__Dialog__Send) { |channel, payload| sent4 << [channel, payload]; true }
dm4.define_singleton_method(:Na__Dialog__Visible?) { true }
dm4.define_singleton_method(:na_showing?) { |_model| true }
begin
    model.active_path = nil
    model.selection.clear
    $NA_TIMERS.clear
    dm4.na_on_ready
    channels = sent4.map(&:first)
    check('icons: a page that comes up gets them first, before the state it draws with',
          channels.include?('icons') && channels.index('icons') < channels.index('state') && sent4.assoc('icons')[1]['Flag'].to_s.start_with?('<svg'))
    check('backstop: a page that comes up starts one watch', $NA_TIMERS.length == 1)
    dm4.Na__Dialog__StartSelectionWatch
    check('backstop: starting it again replaces the watch, never adds a second', $NA_TIMERS.length == 1)

    sent4.clear
    dm4.na_check_selection
    check('backstop: with nothing new since the page heard, it sends nothing', sent4.empty?)

    pieces = (1..100).map { |n| Struct.new(:entityID).new(90_000 + n) }
    model.selection.add(pieces)
    dm4.na_check_selection
    check('backstop: a selection the observers missed reaches the page once', sent4.map(&:first) == ['selection'])
    dm4.na_check_selection
    check('backstop: and not again while it stays the same', sent4.length == 1)
    signature = dm4.na_selection_signature(model)
    check('backstop: it reads the count and only the first 16 entities of a big selection', signature[0] == 100 && signature[1].length == 16)

    top = model.entities.na_items.find { |entity| entity.is_a?(Sketchup::Group) || entity.is_a?(Sketchup::ComponentInstance) }
    model.active_path = [top]
    dm4.na_check_selection
    check('backstop: opening a group counts as a change (the page follows the group)', sent4.length == 2 && sent4.last[0] == 'selection')

    model.selection.clear
    dm4.instance_variable_set(:@na_selection_timer, 99)
    dm4.na_check_selection
    check('backstop: it waits while the observers\' own push is on its way', sent4.length == 2)
    dm4.instance_variable_set(:@na_selection_timer, nil)
    dm4.na_check_selection
    check('backstop: then sends the cleared selection', sent4.length == 3 && sent4.last[1]['count'] == 0)

    dm4.define_singleton_method(:Na__Dialog__Visible?) { false }
    dm4.na_check_selection
    check('backstop: with the dialog shut it stops itself', $NA_TIMERS.empty? && dm4.instance_variable_get(:@na_selection_watch).nil?)
    dm4.define_singleton_method(:Na__Dialog__Visible?) { true }

    # The Follow and Colours switches save one setting each and say what they did
    sent4.clear
    check('switches: Status Colours default to on', AO::Na__ConfigStore.Na__Config__Settings['grading']['status_colours'] == true)
    name_before = AO::Na__ConfigStore.Na__Config__Settings['user']['name']
    AO::Na__ActionRouter.Na__Action__Dispatch('saveSettings', { 'settings' => { 'selection' => { 'follow_selection' => false } },
                                                                 'message' => 'Follow Selection off: the table stays where you leave it.' })
    AO::Na__ActionRouter.Na__Action__Dispatch('saveSettings', { 'settings' => { 'grading' => { 'status_colours' => false } }, 'message' => 'Status Colours off: plain rows.' })
    settings = AO::Na__ConfigStore.Na__Config__Settings
    statuses4 = sent4.select { |pair| pair[0] == 'status' }.map { |pair| pair[1]['message'] }
    check('switches: each saves its own setting and leaves the rest as they were',
          settings['selection']['follow_selection'] == false && settings['grading']['status_colours'] == false &&
          settings['user']['name'] == name_before && settings['grading']['agent_colour'] == '#7c3aed')
    check('switches: the status line says what was switched', statuses4 == ['Follow Selection off: the table stays where you leave it.', 'Status Colours off: plain rows.'])
    AO::Na__ActionRouter.Na__Action__Dispatch('saveSettings', { 'settings' => { 'selection' => { 'follow_selection' => true }, 'grading' => { 'status_colours' => true } } })
    user_settings = AO::Na__ConfigStore.Na__UserConfig__All['settings'] || {}
    check('switches: back on, they match the defaults and leave nothing in the user file',
          !(user_settings['selection'] || {}).key?('follow_selection') && !(user_settings['grading'] || {}).key?('status_colours'))
    check('switches: the Save Settings button still says Settings saved', sent4.select { |pair| pair[0] == 'status' }.last[1]['message'] == 'Settings saved.')
ensure
    dm4.Na__Dialog__StopSelectionWatch
    dm4.instance_variable_set(:@na_page_ready, false)
    dm4.singleton_class.send(:alias_method, :Na__Dialog__Send, :na_test_send4)
    dm4.singleton_class.send(:alias_method, :Na__Dialog__Visible?, :na_test_visible4)
    dm4.singleton_class.send(:alias_method, :na_showing?, :na_test_showing4)
    model.active_path = nil
    model.selection.clear
end

# ---------------------------------------------------------------------------
# 0.1.16: Tree by Tag lists tags under their folders, so the page needs them
# ---------------------------------------------------------------------------
outer16 = Sketchup::LayerFolder.new('01__Existing')
inner16 = Sketchup::LayerFolder.new('Walls', outer16, false)
walls16 = model.layers.add('01__Existing__Walls')
roof16  = model.layers.add('01__Existing__Roof')
walls16.folder = inner16
roof16.folder  = outer16
begin
    tags16 = AO::Na__Payloads.Na__Payload__Tags(model)
    check('tags: a tag in nested folders carries them outermost first, each shown or hidden',
          tags16['01__Existing__Walls']['f'] == ['01__Existing', 'Walls'] && tags16['01__Existing__Walls']['fs'] == [true, false])
    check('tags: a hidden folder hides its tags, a shown one does not',
          tags16['01__Existing__Walls']['v'] == false && tags16['01__Existing__Roof']['v'] == true && tags16['01__Existing__Roof']['f'] == ['01__Existing'])
    check('tags: a tag at the top level carries no folder keys', !tags16['06__Drawings'].key?('f') && !tags16['06__Drawings'].key?('fs'))
    listing16 = OPS.Na__AgentOutliner__McpRead('tags', {})
    walls_listed = listing16['tags'].find { |tag| tag['name'] == '01__Existing__Walls' }
    check('tags: the agents\' tag list still names the folder path', walls_listed && walls_listed['folder'] == '01__Existing / Walls')
ensure
    walls16.folder = nil
    roof16.folder  = nil
end

# ---------------------------------------------------------------------------
# 0.1.17: Show or Hide, the key Adam binds (Noble 3D Tools' toggle_agent_outliner)
# ---------------------------------------------------------------------------
dm17 = AO::Na__DialogManager
calls17 = []
open17 = [false]
dm17.singleton_class.send(:alias_method, :na_test_visible17, :Na__Dialog__Visible?)
dm17.singleton_class.send(:alias_method, :na_test_show17, :Na__Dialog__Show)
dm17.singleton_class.send(:alias_method, :na_test_close17, :Na__Dialog__Close)
dm17.singleton_class.send(:alias_method, :na_test_prefs17, :Na__Dialog__PreferencesPath)
dm17.define_singleton_method(:Na__Dialog__Visible?) { open17[0] }
dm17.define_singleton_method(:Na__Dialog__Show) { calls17 << :show; open17[0] = true; true }
dm17.define_singleton_method(:Na__Dialog__Close) { calls17 << :close; open17[0] = false; nil }
prefs17 = File.join(SCR, 'SharedPreferences.json')
dm17.define_singleton_method(:Na__Dialog__PreferencesPath) { prefs17 }
begin
    first17  = AO.Na__AgentOutliner__ToggleDialog
    second17 = AO.Na__AgentOutliner__ToggleDialog
    check('toggle: shut, it opens; open, it closes', calls17 == [:show, :close] && first17[:message] == 'Agent Outliner opened.' && second17[:message] == 'Agent Outliner closed.' && first17[:success] && second17[:success])

    bound = lambda do |key, ctrl: false, alt: false, shift: false, path: AO::Na__DialogManager::NA_TOGGLE_PATH|
        { 'Alt' => alt, 'Ctrl' => ctrl, 'Key' => key, 'Meta' => false, 'Path' => path, 'Shift' => shift }
    end
    File.write(prefs17, "\uFEFF" + JSON.generate({ 'Windows Only' => { 'Settings' => { 'Shortcuts' => [
        bound.call('9', ctrl: true, shift: true),
        bound.call('O', ctrl: true, alt: true, path: 'Extensions/NA__NOBLE3DMODELLINGTOOLS/show or hide agent outliner'),
        bound.call('\\', alt: true),
        bound.call('NumPad4', ctrl: true),
        bound.call('Left', shift: true),
        bound.call('Escape'),
        bound.call('9', ctrl: true, path: 'Extensions/Na__Noble3dModellingTools/Agent Outliner'),
        bound.call('F7')
    ] } } }))
    keys17 = dm17.Na__Dialog__ToggleKeys
    check('keys: only the Show or Hide bindings are read (any case), each as the page matches it',
          keys17.map { |k| k['label'] } == ['Ctrl+Shift+9', 'Ctrl+Alt+O', 'Alt+\\', 'Ctrl+NumPad4', 'Shift+Left', 'F7'] &&
          keys17.map { |k| k['code'] } == %w[Digit9 KeyO Backslash Numpad4 ArrowLeft F7])
    check('keys: modifiers and the typed character travel too', keys17[0]['ctrl'] && keys17[0]['shift'] && !keys17[0]['alt'] && keys17[1]['char'] == 'O' && keys17[2]['char'] == '\\' && keys17[4]['char'] == '')
    check('keys: a key it cannot name (Escape) is left out, not guessed', keys17.none? { |k| k['label'] == 'Escape' })
    File.write(prefs17, 'not json')
    File.utime(Time.now + 5, Time.now + 5, prefs17)
    check('keys: a broken or missing preferences file gives none', dm17.Na__Dialog__ToggleKeys == [] && (File.delete(prefs17) || true) && dm17.Na__Dialog__ToggleKeys == [])

    sent17 = []
    dm17.singleton_class.send(:alias_method, :na_test_send17, :Na__Dialog__Send)
    dm17.define_singleton_method(:Na__Dialog__Send) { |channel, payload| sent17 << [channel, payload]; true }
    begin
        File.write(prefs17, JSON.generate({ 'Windows Only' => { 'Settings' => { 'Shortcuts' => [bound.call('K', ctrl: true, shift: true)] } } }))
        File.utime(Time.now + 10, Time.now + 10, prefs17)
        dm17.Na__Dialog__PushState
        state17 = sent17.assoc('state')
        check('state: the page is told the Show or Hide keys', state17 && state17[1]['toggle_keys'].map { |k| k['label'] } == ['Ctrl+Shift+K'])

        open17[0] = true
        calls17.clear
        $NA_TIMERS.clear
        AO::Na__ActionRouter.Na__Action__Dispatch('closeDialog', {})
        check('closeDialog: the page\'s key closes the dialog on a later tick, not inside its own callback', calls17.empty? && $NA_TIMERS.length == 1)
        UI.run_timers!
        check('closeDialog: then it is closed', calls17 == [:close])
    ensure
        dm17.singleton_class.send(:alias_method, :Na__Dialog__Send, :na_test_send17)
    end
ensure
    dm17.singleton_class.send(:alias_method, :Na__Dialog__Visible?, :na_test_visible17)
    dm17.singleton_class.send(:alias_method, :Na__Dialog__Show, :na_test_show17)
    dm17.singleton_class.send(:alias_method, :Na__Dialog__Close, :na_test_close17)
    dm17.singleton_class.send(:alias_method, :Na__Dialog__PreferencesPath, :na_test_prefs17)
    File.delete(prefs17) if File.exist?(prefs17)
end

# ---------------------------------------------------------------------------
# 0.1.17: agent_outliner tag_tree, the Tree by Tag view for agents
#   TT__Alpha_Root (untagged)
#     TT__Bravo_Walls (TT__Walls, in folder TT__Existing)
#       TT__Charlie_Part (untagged: goes with Bravo)
#       TT__Delta_Roof (TT__Roof: listed in Bravo AND heads TT__Roof)
#   TT__Foxtrot_Walls (TT__Walls)
#     TT__Golf_Walls (TT__Walls: inside Foxtrot only)
# ---------------------------------------------------------------------------
tt_walls  = model.layers.add('TT__Walls')
tt_roof   = model.layers.add('TT__Roof')
tt_folder = Sketchup::LayerFolder.new('TT__Existing')
tt_walls.folder = tt_folder
tt_alpha  = na_group(model.entities, 'TT__Alpha_Root')
tt_bravo  = na_group(tt_alpha.definition.entities, 'TT__Bravo_Walls', layer: tt_walls)
na_group(tt_bravo.definition.entities, 'TT__Charlie_Part')
tt_delta  = na_group(tt_bravo.definition.entities, 'TT__Delta_Roof', layer: tt_roof)
tt_fox    = na_group(model.entities, 'TT__Foxtrot_Walls', layer: tt_walls)
na_group(tt_fox.definition.entities, 'TT__Golf_Walls', layer: tt_walls)
AO::Na__Tracker.Na__Tracker__Refresh(model)
begin
    check('tag_tree: a read action the MCP is told about', OPS.Na__AgentOutliner__McpActions['read'].include?('tag_tree'))
    walls_tt = OPS.Na__AgentOutliner__McpRead('tag_tree', { 'tag' => 'TT__Walls', 'depth' => 3 })['card']
    names_tt = walls_tt['items'].map { |item| item['name'] }
    check('tag_tree: a tagged group inside an untagged one heads its tag\'s card; a same-tag part stays inside its group',
          names_tt == %w[TT__Bravo_Walls TT__Foxtrot_Walls] && walls_tt['objects_on_tag'] == 3 && walls_tt['folder'] == 'TT__Existing')
    bravo_tt = walls_tt['items'][0]
    check('tag_tree: a top object nested in the model says where it is', bravo_tt['within'].map { |up| up['name'] } == ['TT__Alpha_Root'] && !walls_tt['items'][1].key?('within'))
    kids_tt = bravo_tt['children'].each_with_object({}) { |child, hash| hash[child['name']] = child }
    check('tag_tree: an untagged part is listed inside its tagged group, no tag of its own; a part on another tag names it',
          kids_tt.keys == %w[TT__Charlie_Part TT__Delta_Roof] && !kids_tt['TT__Charlie_Part'].key?('tag') && kids_tt['TT__Delta_Roof']['tag'] == 'TT__Roof')
    roof_tt = OPS.Na__AgentOutliner__McpRead('tag_tree', { 'tag' => 'tt__roof' })['card']
    check('tag_tree: that part heads its own card too (the tag in any case), at its place in the model',
          roof_tt['items'].map { |item| item['name'] } == ['TT__Delta_Roof'] && roof_tt['items'][0]['within'].map { |up| up['name'] } == %w[TT__Alpha_Root TT__Bravo_Walls])
    untagged_tt = OPS.Na__AgentOutliner__McpRead('tag_tree', { 'tag' => 'Untagged', 'depth' => 0 })['card']
    check('tag_tree: Untagged lists top-level untagged objects only (Alpha, never Charlie)',
          untagged_tt['label'] == 'Untagged' && untagged_tt['items'].any? { |item| item['name'] == 'TT__Alpha_Root' } &&
          untagged_tt['items'].none? { |item| item['name'] == 'TT__Charlie_Part' } && untagged_tt['items'].all? { |item| !item.key?('within') })
    shallow_tt = OPS.Na__AgentOutliner__McpRead('tag_tree', { 'tag' => 'TT__Walls', 'depth' => 0 })['card']
    check('tag_tree: depth 0 lists the top objects and counts what is inside', shallow_tt['items'][0]['inside'] == 2 && !shallow_tt['items'][0].key?('children'))
    cut_tt = OPS.Na__AgentOutliner__McpRead('tag_tree', { 'tag' => 'TT__Walls', 'depth' => 3, 'limit' => 2 })
    check('tag_tree: limit stops the listing and says so', cut_tt['listed'] == 2 && cut_tt['truncated'] == true)
    all_tt = OPS.Na__AgentOutliner__McpRead('tag_tree', {})
    folder_tt = all_tt['cards'].find { |entry| entry['kind'] == 'folder' && entry['name'] == 'TT__Existing' }
    check('tag_tree: the whole view: Untagged first, folders holding their tags, tags with no objects left out',
          all_tt['cards'][0]['kind'] == 'tag' && all_tt['cards'][0]['tag'] == '' && folder_tt && folder_tt['items'].map { |entry| entry['tag'] } == ['TT__Walls'] &&
          all_tt['cards'].none? { |entry| entry['kind'] == 'tag' && entry['tag'] == 'TT__Walls' } && all_tt['how_it_reads'].include?('Untagged'))
    check('tag_tree: a tag with nothing on it is refused, naming the tags action', refusal('invalid_params') { OPS.Na__AgentOutliner__McpRead('tag_tree', { 'tag' => 'No Such Tag' }) })
ensure
    tt_walls.folder = nil
end

# ---------------------------------------------------------------------------
# 0.1.18: agent_outliner category_tree, the Group by Category view for agents
# (the shipped standards: CAD__FrontElevation in CAD Elevations, REF in
# References, EDIT in Guides)
#   CT__Alpha_Root (no standard name)
#     REF__CT_Bravo (REF)
#       CT__Charlie_Part (unnamed: goes with Bravo)
#       CAD__FrontElevation__CT_Delta (CAD__FrontElevation: in Bravo AND heads its card)
#   REF__CT_Foxtrot (REF)
#     REF__CT_Golf (REF: inside Foxtrot only)
#   EDIT__CT_Echo (EDIT)
# ---------------------------------------------------------------------------
ct_alpha = na_group(model.entities, 'CT__Alpha_Root')
ct_bravo = na_group(ct_alpha.definition.entities, 'REF__CT_Bravo')
na_group(ct_bravo.definition.entities, 'CT__Charlie_Part')
na_group(ct_bravo.definition.entities, 'CAD__FrontElevation__CT_Delta')
ct_fox = na_group(model.entities, 'REF__CT_Foxtrot')
na_group(ct_fox.definition.entities, 'REF__CT_Golf')
na_group(model.entities, 'EDIT__CT_Echo')
AO::Na__Tracker.Na__Tracker__Refresh(model)
ct_ref_entry = AO::Na__ConfigStore.Na__Standards__Prefixes.find { |p| p['label'] == 'REF' }
ct_names = lambda { |card| card['items'].map { |item| item['name'] }.select { |name| name.include?('CT_') } }
check('category_tree: a read action the MCP is told about', OPS.Na__AgentOutliner__McpActions['read'].include?('category_tree'))
ref_ct = OPS.Na__AgentOutliner__McpRead('category_tree', { 'prefix' => 'ref', 'depth' => 3 })['card']
check('category_tree: a named group inside an unnamed one heads its prefix\'s card (any case); a same-prefix part stays inside its group',
      ct_names.call(ref_ct) == %w[REF__CT_Bravo REF__CT_Foxtrot] && ref_ct['kind'] == 'prefix' && ref_ct['prefix'] == 'REF')
check('category_tree: a card carries its category, colour and meaning from Configure',
      ref_ct['category'] == 'References' && ref_ct['colour'] == ct_ref_entry['colour'] && ref_ct['meaning'] == ct_ref_entry['meaning'] && ref_ct['objects_named'] >= 3)
bravo_ct = ref_ct['items'].find { |item| item['name'] == 'REF__CT_Bravo' }
kids_ct = bravo_ct['children'].each_with_object({}) { |child, hash| hash[child['name']] = child }
check('category_tree: an unnamed part is listed inside its named group; a part with another prefix names it; where a nested top object is',
      kids_ct.keys == %w[CAD__FrontElevation__CT_Delta CT__Charlie_Part] && !kids_ct['CT__Charlie_Part'].key?('prefix') &&
      kids_ct['CAD__FrontElevation__CT_Delta']['prefix'] == 'CAD__FrontElevation' && bravo_ct['within'].map { |up| up['name'] } == ['CT__Alpha_Root'])
fox_ct = ref_ct['items'].find { |item| item['name'] == 'REF__CT_Foxtrot' }
check('category_tree: a same-prefix part is listed once, inside its group', fox_ct['children'].map { |child| child['name'] } == ['REF__CT_Golf'] && !fox_ct['children'][0].key?('prefix'))
cad_ct = OPS.Na__AgentOutliner__McpRead('category_tree', { 'prefix' => 'CAD__FrontElevation__' })['card']
delta_ct = cad_ct['items'].find { |item| item['name'] == 'CAD__FrontElevation__CT_Delta' }
check('category_tree: that part heads its own prefix\'s card too (a trailing __ is fine), at its place in the model',
      delta_ct && delta_ct['within'].map { |up| up['name'] } == %w[CT__Alpha_Root REF__CT_Bravo] && cad_ct['category'] == 'CAD Elevations')
none_ct = OPS.Na__AgentOutliner__McpRead('category_tree', { 'prefix' => 'No Standard Name', 'depth' => 0 })['card']
check('category_tree: No Standard Name lists top-level unnamed objects only (Alpha, never Charlie)',
      none_ct['label'] == 'No Standard Name' && none_ct['prefix'] == '' && none_ct['items'].any? { |item| item['name'] == 'CT__Alpha_Root' } &&
      none_ct['items'].none? { |item| item['name'] == 'CT__Charlie_Part' } && !none_ct.key?('category'))
all_ct = OPS.Na__AgentOutliner__McpRead('category_tree', {})
cat_names = all_ct['cards'].select { |entry| entry['kind'] == 'category' }.map { |entry| entry['name'] }
check('category_tree: the whole view: categories in Configure\'s order holding prefix cards, faces never, No Standard Name last',
      cat_names.index('CAD Elevations') < cat_names.index('References') && cat_names.index('References') < cat_names.index('Guides') &&
      !cat_names.include?('Elevation Faces') && all_ct['cards'].last['prefix'] == '' &&
      all_ct['cards'].find { |entry| entry['name'] == 'Guides' }['items'].map { |entry| entry['prefix'] } == ['EDIT'] && all_ct['view'] == 'Group by Category')
check('category_tree: a prefix nothing is named with is refused, naming the prefixes action',
      refusal('invalid_params') { OPS.Na__AgentOutliner__McpRead('category_tree', { 'prefix' => 'NOPE__Nothing' }) })

report_and_exit
raise "#{$NA_FAIL} checks failed" if $NA_FAIL > 0

