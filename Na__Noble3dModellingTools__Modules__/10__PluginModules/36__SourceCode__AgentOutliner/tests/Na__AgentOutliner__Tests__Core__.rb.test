check('chat: an agent\'s picture is named agt_ and kept in ChatFromAgents, not in Adam\'s folder',
      copy['file'].start_with?('agt_') && File.file?(File.join(CC.Na__Chat__AgentFolder, copy['file'])) && !File.exist?(File.join(CC.Na__Chat__Folder, copy['file'])))
check('chat: a pasted picture still goes in ChatCache as img_', pic.start_with?('img_') && File.file?(File.join(CC.Na__Chat__Folder, pic)))
check('chat: the agents\' folder sits beside Adam\'s, with its own file URL', File.dirname(CC.Na__Chat__AgentFolder) == File.dirname(CC.Na__Chat__Folder) &&
      CC.Na__Chat__AgentFolderUrl.end_with?('/ChatFromAgents/') && CC.Na__Chat__AgentFolderUrl != CC.Na__Chat__FolderUrl)
check('chat: each name finds its own folder; any other name is refused', CC.Na__Chat__Path('agt_20261111_120501_a1b2.png').start_with?(CC.Na__Chat__AgentFolder) &&
      CC.Na__Chat__Path('img_20261111_120501_a1b2.png').start_with?(CC.Na__Chat__Folder) && (begin; CC.Na__Chat__Path('xyz_20261111_120501_a1b2.png'); false; rescue ArgumentError; true; end))
info = CC.Na__Chat__Info
check('chat: Settings counts both folders, the agents\' on its own too', info['agent_files'] >= 2 && info['files'] >= info['agent_files'] + 1 && info['agent_folder'] == CC.Na__Chat__AgentFolder)
check('chat: an agent\'s picture in a thread carries its path in the agents\' folder', AO::Na__Payloads.Na__Payload__Thread(model, user_box)['entries'].any? { |entry| Array(entry['images']).any? { |image| image['path'].to_s.start_with?(CC.Na__Chat__AgentFolder) && image['exists'] } })
CC.send(:remove_const, :NA_NAME_RULE)
CC.const_set(:NA_NAME_RULE, /\Aimg_\d{8}_\d{6}_[0-9a-f]{4}\.(png|jpg|gif|webp)\z/)
