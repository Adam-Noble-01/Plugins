check('last call: seconds since a log time today, and across midnight', AO::Na__ActorDetect.Na__Actor__SecondsAgo('13:57:24', clock_now) == 156 &&
      AO::Na__ActorDetect.Na__Actor__SecondsAgo('23:59:00', Time.new(2026, 11, 12, 0, 1, 0)) == 120 && AO::Na__ActorDetect.Na__Actor__SecondsAgo('soon').nil?)

