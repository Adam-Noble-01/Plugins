check('chat: Reload Plugin Data replaces 0.1.8\'s name rule, so agt_ names are taken at once', 'agt_20261111_120501_a1b2.png'.match?(CC::NA_NAME_RULE))

# ---------------------------------------------------------------------------
# Config store
