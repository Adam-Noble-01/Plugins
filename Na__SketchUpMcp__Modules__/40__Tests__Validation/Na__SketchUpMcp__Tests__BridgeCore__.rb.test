PC = Na__SketchUpMcp::Na__Handlers__PointCloud
PC_CTX = { model: nil, unit: 'mm', warnings: [] }.freeze

na_check('point cloud: without the viewer every tool refuses as unsupported') do
    na_refuses('unsupported') { PC.Na__Handlers__PointCloud__State({}, PC_CTX.dup) } &&
        na_refuses('unsupported') { PC.Na__Handlers__PointCloud__View({ 'shown' => true }, PC_CTX.dup) } &&
        na_refuses('unsupported') { PC.Na__Handlers__PointCloud__Clip({ 'action' => 'on' }, PC_CTX.dup) } &&
        na_refuses('unsupported') { PC.Na__Handlers__PointCloud__Slice({ 'action' => 'count', 'min' => [0, 0, 0], 'max' => [1, 1, 1] }, PC_CTX.dup) }
end

na_check('point cloud: the refusal names the viewer version to install') do
    PC.na_operations
    false
rescue Na__SketchUpMcp::Na__McpError => error
    error.message.include?('0.13.1') && error.na_hint.to_s.include?('Reload')
end

na_check('point cloud: an unknown action is refused before the viewer is asked') do
    na_refuses('invalid_params') { PC.Na__Handlers__PointCloud__Clip({ 'action' => 'delete' }, PC_CTX.dup) } &&
        na_refuses('invalid_params') { PC.Na__Handlers__PointCloud__Slice({ 'action' => 'cut' }, PC_CTX.dup) }
end

na_check('point cloud: per_inch follows the call units') do
    na_close(PC.na_arguments(unit: 'mm')['per_inch'], 25.4) && na_close(PC.na_arguments(unit: 'm')['per_inch'], 0.0254) &&
        na_close(PC.na_arguments(unit: 'in')['per_inch'], 1.0)
end

na_check('router: the four point cloud tools are routed; only point_cloud_clip is kept out of batches') do
    routes = Na__SketchUpMcp::Na__CommandRouter::NA_HANDLER_ROUTES
    forbidden = Na__SketchUpMcp::Na__CommandRouter::NA_BATCH_FORBIDDEN
    %w[point_cloud_state point_cloud_clip point_cloud_view point_cloud_slice point_cloud_fit point_cloud_check point_cloud_heightmap].all? { |name| routes[name] && routes[name][0] == :Na__Handlers__PointCloud } &&
        forbidden.key?('point_cloud_clip') && %w[point_cloud_state point_cloud_view point_cloud_slice point_cloud_fit point_cloud_check point_cloud_heightmap].none? { |name| forbidden.key?(name) }
end

na_check('point cloud: point_cloud_heightmap refuses the other action\'s keys before asking the viewer (1.0.16)') do
    na_refuses('invalid_params') { PC.Na__Handlers__PointCloud__Heightmap({ 'action' => 'profile', 'path' => [[0, 0], [1, 0]], 'resolution' => 50 }, PC_CTX.dup) } &&
        na_refuses('invalid_params') { PC.Na__Handlers__PointCloud__Heightmap({ 'min' => [0, 0, 0], 'max' => [1, 1, 1], 'step' => 50 }, PC_CTX.dup) } &&
        na_refuses('invalid_params') { PC.Na__Handlers__PointCloud__Heightmap({ 'action' => 'slice' }, PC_CTX.dup) }
end

na_check('point cloud: heightmap save_path takes the action\'s extensions, the first by default (1.0.16)') do
    folder = Dir.mktmpdir('na_mcp_height_')
    taken = File.join(folder, 'taken.asc')
    File.binwrite(taken, 'x')
    ok = PC.na_save_path({ 'save_path' => File.join(folder, 'ground') }, %w[.npz .asc]).end_with?('ground.npz') &&
         PC.na_save_path({ 'save_path' => File.join(folder, 'ground.ASC') }, %w[.npz .asc]).end_with?('ground.ASC') &&
         na_refuses('invalid_params') { PC.na_save_path({ 'save_path' => File.join(folder, 'ground.tif') }, %w[.npz .asc]) } &&
         na_refuses('file_error') { PC.na_save_path({ 'save_path' => taken }, %w[.npz .asc]) } &&
         na_refuses('invalid_params') { PC.na_image_path('image_path' => File.join(folder, 'ground.jpg')) }
    FileUtils.rm_rf(folder)
    ok
end

na_check('point cloud: points save_path must be a .npz in a folder that exists (1.0.12)') do
    folder = Dir.mktmpdir('na_mcp_npz_')
    plain = PC.na_npz_path('save_path' => File.join(folder, 'stair'))
    taken = File.join(folder, 'taken.npz')
    File.binwrite(taken, 'x')
    ok = plain.end_with?('stair.npz') &&
         na_refuses('invalid_params') { PC.na_npz_path('save_path' => File.join(folder, 'stair.csv')) } &&
         na_refuses('file_error') { PC.na_npz_path('save_path' => File.join(folder, 'missing', 'a.npz')) } &&
         na_refuses('file_error') { PC.na_npz_path('save_path' => taken) } &&
         PC.na_npz_path('save_path' => taken, 'overwrite' => true) == File.expand_path(taken)
    FileUtils.rm_rf(folder)
    ok
end

# Shown as SketchUp draws it (1.0.17): hidden, on a hidden tag or in a hidden tag folder is left out.
NaTestTag = Struct.new(:visible, :folder) do
    def visible? = visible
end

class NaShownFace < Sketchup::Face
    attr_reader :layer

    def initialize(hidden, layer)
        @hidden = hidden
        @layer = layer
    end

    def hidden? = @hidden
end

class NaShownGroup < Sketchup::Group
    attr_reader :layer, :definition

    def initialize(hidden, layer, children)
        @hidden = hidden
        @layer = layer
        @definition = Struct.new(:entities).new(children)
    end

    def hidden? = @hidden
end

na_check('point cloud: the check and overlays skip hidden groups, hidden faces, hidden tags and closed tag folders (1.0.17)') do
    on = NaTestTag.new(true, nil)
    off = NaTestTag.new(false, nil)
    in_closed = NaTestTag.new(true, NaTestTag.new(true, NaTestTag.new(false, nil)))
    keep_top = NaShownFace.new(false, on)
    keep_inner = NaShownFace.new(false, nil)
    dropped = [NaShownFace.new(true, on), NaShownFace.new(false, off), NaShownFace.new(false, in_closed)]
    tree = [keep_top, NaShownGroup.new(true, on, [NaShownFace.new(false, on)]), NaShownGroup.new(false, off, [NaShownFace.new(false, on)]),
            NaShownGroup.new(false, on, [keep_inner] + dropped)]
    seen = []
    PC.na_walk_shown(tree, [], { remaining: 100, visited: 0, truncated: false }) { |entity, _path| seen << entity if entity.is_a?(Sketchup::Face) }
    seen == [keep_top, keep_inner] && PC.na_shown?(keep_top) && !PC.na_shown?(dropped[2]) && !PC.na_shown?(dropped[1])
end

