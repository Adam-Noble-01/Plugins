# The real seam from the GLB Builder beside this plugin: its actions must be the handler's, one for one.
tvx_seam = File.join(File.dirname(NA_ROOT), 'Na__TrueVision__GlbBuilderUtility__Modules__', '07__Plugin__McpOperations',
                     'Na__TrueVision__GlbBuilder__McpOperations__Main__.rb')
