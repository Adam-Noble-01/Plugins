# -----------------------------------------------------------------------------
# REGION | Solid Health (face orientation, on a 2 x 2 x 2 cube of doubles)
# -----------------------------------------------------------------------------

class NaTestVertex
    attr_reader :position

    def initialize(point)
        @position = point
    end
end

# An edge knows its faces; reversed_in? asks the face which way its loop runs.
class NaTestEdge
    attr_reader :faces, :ends

    def initialize(first, second)
        @ends = [first, second]
        @faces = []
    end

    def entityID
        object_id
    end

    def reversed_in?(face)
        face.na_runs_backwards?(self)
    end
end

class NaTestFace
    attr_reader :edges

    def initialize(indices, points, edge_table)
        @indices = indices.dup
        @points = points
        @edges = na_loop_pairs.map do |first, second|
            key = [first, second].sort
            edge = (edge_table[key] ||= NaTestEdge.new(*key))
            edge.faces << self
            edge
        end
    end

    def entityID
        object_id
    end

    def valid?
        true
    end

    def reverse!
        @indices.reverse!
        self
    end

    def vertices
        @indices.map { |index| NaTestVertex.new(Geom::Point3d.new(*@points[index])) }
    end

    def normal
        Geom::Vector3d.new(*Na__SketchUpMcp::Na__LinearMath.Na__LinearMath__PolygonNormal(@indices.map { |index| @points[index] }))
    end

    def area
        sums = [0.0, 0.0, 0.0]
        loop_points = @indices.map { |index| @points[index] }
        loop_points.each_with_index do |point, position|
            following = loop_points[(position + 1) % loop_points.length]
            sums[0] += (point[1] - following[1]) * (point[2] + following[2])
            sums[1] += (point[2] - following[2]) * (point[0] + following[0])
            sums[2] += (point[0] - following[0]) * (point[1] + following[1])
        end
        Math.sqrt(sums.sum { |value| value * value }) / 2.0
    end

    def na_loop_pairs
        @indices.each_with_index.map { |index, position| [index, @indices[(position + 1) % @indices.length]] }
    end

    def na_runs_backwards?(edge)
        na_loop_pairs.any? { |first, second| [second, first] == edge.ends }
    end
end

SH = Na__SketchUpMcp::Na__SolidHealth
CUBE_POINTS = [[0, 0, 0], [2, 0, 0], [2, 2, 0], [0, 2, 0], [0, 0, 2], [2, 0, 2], [2, 2, 2], [0, 2, 2]].freeze
CUBE_OUTWARD = [[0, 3, 2, 1], [4, 5, 6, 7], [0, 1, 5, 4], [2, 3, 7, 6], [1, 2, 6, 5], [3, 0, 4, 7]].freeze

# reverse: indices of faces to wind inward; drop: faces to leave out (an open box).
def na_cube(reverse: [], drop: [])
    table = {}
    CUBE_OUTWARD.each_with_index.reject { |_loop, index| drop.include?(index) }.map do |loop_indices, index|
        NaTestFace.new(reverse.include?(index) ? loop_indices.reverse : loop_indices, CUBE_POINTS, table)
    end
end

na_check('solid: outward cube has volume +8 and needs nothing') do
    faces = na_cube
    report = SH.Na__SolidHealth__OrientShells(faces)
    report == { 'shells' => 1, 'closed_shells' => 1, 'faces_flipped' => 0, 'shells_turned_outward' => 0 } && na_close(SH.Na__SolidHealth__SignedVolume(faces), 8.0)
end
na_check('solid: two wrongly wound faces are turned to match') do
    faces = na_cube(reverse: [1, 4])
    report = SH.Na__SolidHealth__OrientShells(faces)
    report['faces_flipped'] == 2 && report['shells_turned_outward'].zero? && na_close(SH.Na__SolidHealth__SignedVolume(faces), 8.0)
end
na_check('solid: an inside-out cube is turned outward') do
    faces = na_cube(reverse: (0..5).to_a)
    before = SH.Na__SolidHealth__SignedVolume(faces)
    report = SH.Na__SolidHealth__OrientShells(faces)
    na_close(before, -8.0) && report['shells_turned_outward'] == 1 && na_close(SH.Na__SolidHealth__SignedVolume(faces), 8.0)
end
na_check('solid: a wrong first face is outvoted by the volume check') do
    faces = na_cube(reverse: [0])
    report = SH.Na__SolidHealth__OrientShells(faces)
    report['faces_flipped'] == 5 && report['shells_turned_outward'] == 1 && na_close(SH.Na__SolidHealth__SignedVolume(faces), 8.0)
end
na_check('solid: an open box is made consistent but not called closed') do
    faces = na_cube(reverse: [2], drop: [1])
    report = SH.Na__SolidHealth__OrientShells(faces)
    report['closed_shells'].zero? && report['shells'] == 1 && report['faces_flipped'] == 1
end

