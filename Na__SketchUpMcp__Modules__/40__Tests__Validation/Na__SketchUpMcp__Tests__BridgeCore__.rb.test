        actions = seam.Na__GlbBuilder__McpActions
        actions['read'] == TVX::NA_READ_ACTIONS && actions['edit'] == TVX::NA_EDIT_ACTIONS && actions['publish'] == TVX::NA_PUBLISH_ACTIONS
    end
    na_check('glb builder: with the seam loaded, the handler finds it') { TVX.na_operations.equal?(seam) }
    na_check('glb builder: a seam refusal becomes an MCP error with its code, hint and details') do
        TVX.na_forward({ warnings: [] }) do
            raise ::TrueVision3D::GlbBuilderUtility::Na__McpOperationsError.new('confirmation_required', 'Pushing needs confirm.', 'Pass confirm: "SK02".', { 'a' => 1 })
        end
        false
    rescue Na__SketchUpMcp::Na__McpError => error
        error.na_code == 'confirmation_required' && error.na_hint == 'Pass confirm: "SK02".' && error.na_details == { 'a' => 1 }
    end
    na_check('glb builder: a fault inside the GLB Builder comes back as glb_builder_error, not a crash') do
        na_refuses('glb_builder_error') { TVX.Na__Handlers__TrueVisionExport__Read({ 'action' => 'status' }, TVX_CTX.dup) }
    end
    na_check('glb builder: publish refuses an unconfirmed push before anything runs') do
        seam.define_singleton_method(:na_publish_ready) { |_why| { project_code: 'SK02', linked: true } }
        refused = na_refuses('confirmation_required') { TVX.Na__Handlers__TrueVisionExport__Publish({ 'action' => 'push', 'confirm' => 'RB05' }, TVX_CTX.dup) }
        seam.singleton_class.send(:remove_method, :na_publish_ready)
        refused
    end
else
    na_check("glb builder: the GLB Builder seam was not found at #{tvx_seam}") { false }
end

