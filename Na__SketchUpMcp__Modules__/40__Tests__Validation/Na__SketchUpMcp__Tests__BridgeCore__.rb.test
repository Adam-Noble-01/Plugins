# -----------------------------------------------------------------------------
# REGION | Socket Server Over Real TCP
# -----------------------------------------------------------------------------

server = Na__SketchUpMcp::Na__SocketServer
status = server.Na__SocketServer__Start
na_check('server: started on a free port from 18385') { status['running'] && status['port'].between?(18_385, 18_394) }
connection_path = File.join(NA_TEST_DIR, 'Connections', "Na__SketchUpMcp__Connection__#{Process.pid}.json")
connection = File.exist?(connection_path) ? JSON.parse(File.read(connection_path)) : {}
na_check('server: connection file written with port and token') { connection['port'] == status['port'] && connection['token'].to_s.length == 32 }

def na_exchange(port, payload_line, pumps = 400)
    reply = nil
    client = Thread.new do
        socket = TCPSocket.new('127.0.0.1', port)
        socket.write(payload_line)
        reply = socket.gets
        socket.close
    end
    pumps.times do
        Na__SketchUpMcp::Na__SocketServer.Na__SocketServer__Pump
        break unless client.alive?

        sleep 0.005
    end
    client.join(2)
    reply
end

ping = { 'id' => 1, 'token' => connection['token'], 'command' => 'ping', 'params' => {} }
ping_reply = na_exchange(status['port'], JSON.generate(ping) + "\n")
na_check('server: ping answered') do
    parsed = JSON.parse(ping_reply.to_s)
    parsed['ok'] == true && parsed['result']['pong'] == true && parsed['id'] == 1
end

bad_token = na_exchange(status['port'], JSON.generate(ping.merge('token' => 'x' * 32)) + "\n")
na_check('server: wrong token refused') { JSON.parse(bad_token.to_s).dig('error', 'code') == 'unauthorized' }

http_reply = na_exchange(status['port'], "POST / HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n{\"command\":\"ping\"}\n")
na_check('server: HTTP-style first line dropped without reply') { http_reply.nil? }

unknown = na_exchange(status['port'], JSON.generate(ping.merge('command' => 'no_such_command')) + "\n")
na_check('server: unknown command named') { JSON.parse(unknown.to_s).dig('error', 'code') == 'unknown_command' }

probe = na_exchange(status['port'], JSON.generate(ping.merge('command' => 'api_probe', 'params' => { 'signatures' => ['Geom::Point3d#x', 'Geom::Point3d#no_such', 'Nope::Thing#x'] })) + "\n")
na_check('server: api_probe answers true / false / nil') do
    results = JSON.parse(probe.to_s).dig('result', 'results') || {}
    results['Geom::Point3d#x'] == true && results['Geom::Point3d#no_such'] == false && results['Nope::Thing#x'].nil?
end

silent = TCPSocket.new('127.0.0.1', status['port'])
started = Time.now
20.times { server.Na__SocketServer__Pump }
na_check('server: an idle client never blocks the pump') { Time.now - started < 0.5 }
silent.close

server.Na__SocketServer__Stop(silent: true)
na_check('server: stop removes the connection file') { !File.exist?(connection_path) }
FileUtils.rm_rf(NA_TEST_DIR)

# endregion -------------------------------------------------------------------

puts "BridgeCore: #{$na_passed} passed, #{$na_failed.length} failed."
$na_failed.each { |label| puts "  FAILED: #{label}" }
raise 'BridgeCore tests failed' unless $na_failed.empty?

# =============================================================================
# END OF FILE
# =============================================================================
