# -----------------------------------------------------------------------------
# REGION | Code Under Test
# -----------------------------------------------------------------------------

NA_ROOT = $NA_MODULES_ROOT
%w[
    03__Plugin__CoreAppLogic/Na__SketchUpMcp__CoreAppLogic__PathResolver__.rb
    03__Plugin__CoreAppLogic/Na__SketchUpMcp__CoreAppLogic__ConfigLoader__.rb
    03__Plugin__CoreAppLogic/Na__SketchUpMcp__CoreAppLogic__ActivityLog__.rb
    04__Plugin__BridgeCore/Na__SketchUpMcp__BridgeCore__McpError__.rb
    06__Plugin__BridgeHelpers/Na__SketchUpMcp__BridgeHelpers__Params__.rb
    06__Plugin__BridgeHelpers/Na__SketchUpMcp__BridgeHelpers__Units__.rb
    06__Plugin__BridgeHelpers/Na__SketchUpMcp__BridgeHelpers__LinearMath__.rb
    06__Plugin__BridgeHelpers/Na__SketchUpMcp__BridgeHelpers__Creation__.rb
    06__Plugin__BridgeHelpers/Na__SketchUpMcp__BridgeHelpers__SolidHealth__.rb
    04__Plugin__BridgeCore/Na__SketchUpMcp__BridgeCore__ConnectionFile__.rb
    04__Plugin__BridgeCore/Na__SketchUpMcp__BridgeCore__ApiSelfTest__.rb
    04__Plugin__BridgeCore/Na__SketchUpMcp__BridgeCore__CommandRouter__.rb
