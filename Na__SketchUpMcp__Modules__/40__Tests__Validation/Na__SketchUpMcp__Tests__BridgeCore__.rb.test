    10__BridgeHandlers/Na__SketchUpMcp__Handlers__Status__.rb
].each { |relative| load File.join(NA_ROOT, relative) }

# Keep test connection files and settings out of the real 91__UserConfig__LocalOnly.
NA_TEST_DIR = Dir.mktmpdir('na_mcp_ruby_test_')
module Na__SketchUpMcp
    module Na__PathResolver
        def self.Na__PathResolver__ConnectionsDirectory
            File.join(NA_TEST_DIR, 'Connections')
        end
    end

    module Na__ConfigLoader
        def self.Na__ConfigLoader__UserSettings
            { 'bridge' => { 'port' => 18_385 } }
        end
    end
end

