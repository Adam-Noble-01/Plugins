# =============================================================================
# NA SKETCHUP MCP - TESTS - BRIDGE CORE (RUBY, SKETCHUP'S OWN RUBY 3.2)
# =============================================================================
#
# FILE       : Na__SketchUpMcp__Tests__BridgeCore__.rb.test
# PURPOSE    : Check the bridge's pure Ruby parts outside SketchUp: linear maths,
#              units, params, Outliner names, face orientation, and the socket
#              server end to end over real TCP
# CREATED    : 2026
#
# RUN: python Na__SketchUpMcp__Tests__RunRubyChecks__.py Na__SketchUpMcp__Tests__BridgeCore__.rb.test
#
# The .rb.test extension keeps Reload Plugin Data from ever loading this file
# into SketchUp. Only tiny doubles of Sketchup/UI/Geom are defined here; the
# code under test is the real plugin code.
#
# =============================================================================

Encoding.const_set(:UTF_8, Encoding.find('UTF-8')) unless Encoding.const_defined?(:UTF_8)
Encoding.const_set(:BINARY, Encoding.find('ASCII-8BIT')) unless Encoding.const_defined?(:BINARY)

