na_check('container path: a definition, whose parent is the DefinitionList, has none') do
    CO.Na__Coordinates__ContainerPathForEntity(na_test_model, NaTestEntity.new(Sketchup::DefinitionList.new)) == []
end
na_check('container path: a material, whose parent is the Materials, has none') do
    CO.Na__Coordinates__ContainerPathForEntity(na_test_model, NaTestEntity.new(Sketchup::Materials.new)) == []
end
na_check('container path: a root entity has none') do
    CO.Na__Coordinates__ContainerPathForEntity(na_test_model, NaTestEntity.new(na_test_model)) == []
end
na_check('container path: no parent has none') do
    CO.Na__Coordinates__ContainerPathForEntity(na_test_model, NaTestEntity.new(nil)) == []
end
na_check('container path: an entity inside a definition still finds its instance') do
    holder = Sketchup::ComponentDefinition.new
    instance = NaTestEntity.new(na_test_model, holder)
    holder.instances = [instance]
    CO.Na__Coordinates__ContainerPathForEntity(na_test_model, NaTestEntity.new(holder)) == [instance]
end
na_check('entity summary: a definition reports its name, though it is a Drawingelement') do
    summary = {}
    Na__SketchUpMcp::Na__Serializer.na_add_names(summary, Sketchup::ComponentDefinition.new)
    summary['name'] == 'Test Definition'
end
na_check('entity summary: a face still reports no name') do
    summary = {}
    Na__SketchUpMcp::Na__Serializer.na_add_names(summary, Sketchup::Face.new)
    summary.empty?
end

