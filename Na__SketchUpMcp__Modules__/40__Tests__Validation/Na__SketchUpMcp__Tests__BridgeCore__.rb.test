# -----------------------------------------------------------------------------
# REGION | Units and Params
# -----------------------------------------------------------------------------

na_check('units: 25.4 mm is one inch') { na_close(UN.Na__Units__ToInches(25.4, 'mm'), 1.0) }
na_check('units: "2.4m" read as 2400 mm') { na_close(UN.Na__Units__FromInches(UN.Na__Units__ToInches('2.4m', 'mm'), 'mm'), 2400.0) }
na_check("units: 8'6\" is 102 inches") { na_close(UN.Na__Units__ToInches("8'6\"", 'mm'), 102.0) }
na_check('units: "96in" in a mm call') { na_close(UN.Na__Units__ToInches('96in', 'mm'), 96.0) }
na_check('units: bare string uses the call unit') { na_close(UN.Na__Units__ToInches('1000', 'mm'), 1000.0 / 25.4) }
na_check('units: nonsense string refused') { na_refuses('invalid_params') { UN.Na__Units__ToInches('twelve', 'mm') } }
na_check('units: unknown unit refused with the list') { na_refuses('invalid_params') { UN.Na__Units__Resolve('furlong', nil) } }
na_check('units: aliases (millimetres -> mm)') { UN.Na__Units__Resolve('millimetres', nil) == 'mm' }
na_check('units: area mm2') { na_close(UN.Na__Units__AreaFromSquareInches(1.0, 'mm'), 645.16) }
na_check('units: degrees round trip') { na_close(UN.Na__Units__Degrees(UN.Na__Units__Radians(37.5)), 37.5) }
na_check('units: zero-length direction refused') { na_refuses('invalid_params') { UN.Na__Units__Direction([0, 0, 0]) } }
na_check('params: integer out of range refused, not clamped') { na_refuses('invalid_params') { PA.Na__Params__Integer({ 'n' => 99 }, 'n', nil, max: 10) } }
na_check('params: 3.0 accepted as integer 3') { PA.Na__Params__Integer({ 'n' => 3.0 }, 'n') == 3 }
na_check('params: enum refused with choices') { na_refuses('invalid_params') { PA.Na__Params__Enum({ 'a' => 'x' }, 'a', %w[p q]) } }
na_check('params: id array rejects strings') { na_refuses('invalid_params') { PA.Na__Params__IdArray({ 'ids' => ['12'] }, 'ids') } }
na_check('params: missing required refused') { na_refuses('invalid_params') { PA.Na__Params__Required({}, 'code') } }

