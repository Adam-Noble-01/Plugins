module Sketchup
    class Model
        def title
            'Test Model'
        end

        def path
            ''
        end

        def active_path
            nil
        end
    end

    # What Entity#parent gives for things outside the drawing (SketchUp 2027).
    class DefinitionList; end
    class Materials; end

    # The real API makes a definition a Drawingelement, as it does an instance.
    class Drawingelement; end
    class Group < Drawingelement; end
    class ComponentInstance < Drawingelement; end
    class Face < Drawingelement; end
    class SectionPlane < Drawingelement; end

    class ComponentDefinition < Drawingelement
        attr_accessor :instances

        def initialize
            @instances = []
        end

        def name
            'Test Definition'
        end
    end

    def self.version
        '26.2.243'
    end

    def self.status_text=(_text); end

    def self.active_model
        @na_model ||= Model.new
    end
end

module UI
    def self.start_timer(_interval, _repeat = false, &block)
        @na_timer = block
        1
    end

    def self.stop_timer(_id)
        @na_timer = nil
    end
end

module Geom
    class Point3d
        attr_reader :x, :y, :z

        def initialize(x = 0, y = 0, z = 0)
            @x = x.to_f
            @y = y.to_f
            @z = z.to_f
        end

        def to_a
            [@x, @y, @z]
        end
    end

    class Vector3d < Point3d; end
end

