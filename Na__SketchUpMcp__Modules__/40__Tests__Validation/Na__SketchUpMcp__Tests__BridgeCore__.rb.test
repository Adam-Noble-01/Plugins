CR = Na__SketchUpMcp::Na__Creation
inches = ->(*millimetres) { millimetres.map { |value| value / 25.4 } }
na_check('name: box size in mm') { CR.Na__Creation__SizeText([inches.(0, 0, 0), inches.(1200, 600, 150)], 'mm') == '1200 x 600 x 150' }
na_check('name: flat face drops its zero axis') { CR.Na__Creation__SizeText([inches.(0, 0, 0), inches.(6000, 4000, 0)], 'mm') == '6000 x 4000' }
na_check('name: floating-point noise rounds away') { CR.Na__Creation__SizeText([inches.(10, 10, 10), inches.(1210.0004, 610, 160)], 'mm') == '1200 x 600 x 150' }
na_check('name: metres keep decimals and say so') { CR.Na__Creation__SizeText([inches.(0, 0, 0), inches.(1200, 600, 150)], 'm') == '1.2 x 0.6 x 0.15 m' }
na_check('name: no bounds -> no size') { CR.Na__Creation__SizeText(nil, 'mm') == '' }
na_check('name: compact number') { CR.Na__Creation__CompactNumber(2400.0004, 'mm') == '2400' && CR.Na__Creation__CompactNumber(-0.0001, 'mm') == '0' }
na_check('name: plan section') { CR.Na__Creation__SectionName([0, 0, 1200], [0, 0, -1], 'mm') == 'Plan section at 1200' }
na_check('name: vertical section on x') { CR.Na__Creation__SectionName([3000, 0, 0], [1, 0, 0], 'mm') == 'Section at x = 3000' }
na_check('name: 2D point means z = 0') { CR.Na__Creation__SectionName([5, 5], [0, 0, 1], 'm') == 'Plan section at 0 m' }
na_check('name: oblique section') { CR.Na__Creation__SectionName([0, 0, 0], [1, 1, 0], 'mm') == 'Section plane' }

