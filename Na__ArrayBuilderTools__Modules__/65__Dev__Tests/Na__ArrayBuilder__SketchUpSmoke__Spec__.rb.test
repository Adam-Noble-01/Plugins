# =============================================================================
# NA ARRAY BUILDER TOOLS - NATIVE SKETCHUP SMOKE CHECK
# =============================================================================
# Run explicitly in SketchUp's Ruby Console with a NEW, EMPTY test model.
# This leaves the test arrays visible for inspection. It never saves the model.

raise 'Load Array Builder first.' unless defined?(Na__ArrayBuilderTools::Na__ArrayBuilder__GeometryBuilder)
na_model = Sketchup.active_model
unless na_model.active_path.nil? && na_model.entities.empty?
    raise 'Open a new, empty model before running the Array Builder native smoke check.'
end

na_builder = Na__ArrayBuilderTools::Na__ArrayBuilder__GeometryBuilder
na_serializer = Na__ArrayBuilderTools::Na__ArrayBuilder__DataSerializer
na_config = Na__ArrayBuilderTools::Na__ArrayBuilder__Configuration.Na__Config__Resolve(
    'unit_width_mm' => 100, 'unit_depth_mm' => 50, 'unit_height_mm' => 120,
    'spacing_mm' => 100, 'path_source' => 'selection'
)
na_points = [Geom::Point3d.new(0,0,0), Geom::Point3d.new(2000.mm,0,0), Geom::Point3d.new(2000.mm,1000.mm,0)]
na_array = na_builder.na_create_array(na_points, na_config)
raise 'Array recipe missing.' unless na_serializer.Na__Data__HasData?(na_array)
na_original = na_serializer.Na__Data__Load(na_array)
raise 'Path round trip failed.' unless na_serializer.Na__Data__Points(na_original) == na_points

na_model.start_operation('Copy Smoke Array', true)
na_copy = na_model.entities.add_instance(na_array.definition, Geom::Transformation.translation([0,1500.mm,0]))
na_model.commit_operation
na_builder.Na__Geometry__Update(na_model, na_array, na_config.merge('spacing_mm' => 60), 'single')
raise 'Single scope changed its copy.' unless na_serializer.Na__Data__Load(na_copy) == na_original
raise 'Single scope did not isolate the definition.' if na_array.definition == na_copy.definition

na_model.start_operation('Create Linked Smoke Copy', true)
na_linked = na_model.entities.add_instance(na_array.definition, Geom::Transformation.translation([0,3000.mm,0]))
na_model.commit_operation
na_builder.Na__Geometry__Update(na_model, na_array, na_config.merge('unit_height_mm' => 300), 'linked')
raise 'Linked update failed.' unless na_serializer.Na__Data__Load(na_linked)['configuration']['unit_height_mm'] == 300
na_model.undo
raise 'Undo did not restore data.' unless na_serializer.Na__Data__Load(na_array)['configuration']['unit_height_mm'] == 120
na_model.redo
raise 'Redo did not restore data.' unless na_serializer.Na__Data__Load(na_array)['configuration']['unit_height_mm'] == 300
# REGION | Real native solid union and a reversible recipe
na_merge_config = na_config.merge('distribution'=>'normalise','merge_corners'=>true)
na_merged_array = na_builder.na_create_array(na_points.map { |na_point| na_point.offset(Y_AXIS,4500.mm) },na_merge_config)
na_units = na_merged_array.definition.entities.select { |na_entity| na_entity.get_attribute(na_serializer::NA_INSTANCE_DICT,'role')=='unit' }
na_merged_corners = na_units.grep(Sketchup::Group)
raise 'The bend did not produce a native solid union.' unless na_merged_corners.length==1 && na_merged_corners.first.definition.manifold?
na_builder.Na__Geometry__Update(na_model,na_merged_array,na_merge_config.merge('merge_corners'=>false),'single')
raise 'Disabling merge did not regenerate individual blocks.' unless na_merged_array.definition.entities.grep(Sketchup::Group).empty?

# REGION | World-coordinate contract at three actual open nesting levels
na_model.start_operation('Nested Array Smoke Fixture',true)
na_outer = na_model.entities.add_group
na_outer.transformation = Geom::Transformation.translation([7000.mm,1000.mm,600.mm]) * Geom::Transformation.rotation(ORIGIN,Z_AXIS,32.degrees)
na_middle = na_outer.entities.add_group
na_middle.transformation = Geom::Transformation.translation([400.mm,700.mm,200.mm]) * Geom::Transformation.rotation(ORIGIN,X_AXIS,18.degrees)
na_inner = na_middle.entities.add_group
na_inner.transformation = Geom::Transformation.translation([100.mm,200.mm,300.mm]) * Geom::Transformation.scaling(1.2,0.8,1.1)
na_inner.entities.add_cpoint(ORIGIN)
na_model.commit_operation
na_world_path = [Geom::Point3d.new(8000.mm,1000.mm,1000.mm),Geom::Point3d.new(10000.mm,1000.mm,1000.mm)]
begin
    na_model.active_path = [na_outer,na_middle,na_inner]
    na_nested_array = na_builder.na_create_array(na_world_path,na_config.merge('path_source'=>'draw'))
    na_saved_local = na_serializer.Na__Data__Points(na_serializer.Na__Data__Load(na_nested_array))
    unless na_saved_local.zip(na_world_path).all? { |na_local,na_world| na_local.transform(na_nested_array.transformation).distance(na_world)<0.001 }
        raise 'Nested draw/create applied an extra parent transform.'
    end
    na_model.start_operation('Selected Nested Path Fixture',true)
    na_edges = na_model.active_entities.add_edges(*na_world_path)
    na_model.commit_operation
    na_selected = Na__ArrayBuilderTools::Na__ArrayBuilder__PathFromSelection.Na__PathFromSelection__BuildFromEntities(na_edges)
    raise 'Nested selected path failed.' unless na_selected[:valid]
    unless na_selected[:points].all? { |na_point| na_world_path.any? { |na_world| na_point.distance(na_world)<0.001 } }
        raise 'Selected active vertices were not handled in world coordinates.'
    end
ensure
    na_model.active_path = nil
end
na_world_transform = Sketchup::InstancePath.new([na_outer,na_middle,na_inner,na_nested_array]).transformation
unless na_saved_local.zip(na_world_path).all? { |na_local,na_world| na_local.transform(na_world_transform).distance(na_world)<0.001 }
    raise 'Nested array moved when leaving its editing context.'
end
# REGION | Real Group source, embedded native SKP and missing-definition recovery
na_registry = Na__ArrayBuilderTools::Na__ArrayBuilder__ObjectRegistry
na_archive = Na__ArrayBuilderTools::Na__ArrayBuilder__SourceArchive
na_model.start_operation('Custom Group Source Fixture',true)
na_source_group = na_model.entities.add_group
na_source_group.name = 'Nested custom smoke source'
na_child = na_source_group.entities.add_group
na_face = na_child.entities.add_face([0,0,0],[100.mm,0,0],[100.mm,50.mm,0],[0,50.mm,0])
na_face.reverse! if na_face.normal.z < 0
na_face.pushpull(300.mm)
na_child.transformation = Geom::Transformation.translation([25.mm,40.mm,10.mm])
na_child.set_attribute('Na__ArraySmoke','nested_marker','preserved')
na_child.entities.grep(Sketchup::Face).each { |na_item| na_item.material = 'red' }
na_source_definition = na_source_group.definition
na_original_path = na_source_definition.path
na_model.commit_operation
na_registry.Na__Registry__SetDefinition(na_source_definition,na_source_group.name,[2,3,4])
na_object_config = na_config.merge('type'=>'object')
na_object_path = [Geom::Point3d.new(0,6000.mm,0),Geom::Point3d.new(3000.mm,6000.mm,0)]
na_object_array = na_builder.na_create_array(na_object_path,na_object_config)
na_object_data = na_serializer.Na__Data__Load(na_object_array)
raise 'Archiving changed the original source file path.' unless na_source_definition.path==na_original_path
raise 'Native source archive missing.' unless na_object_data['source']['archive_id']
na_registry.Na__Registry__Clear()
na_restored = na_serializer.Na__Data__RestoreSource(na_object_array,na_object_data)
raise 'Group array did not restore its original source.' unless na_restored[:definition]==na_source_definition && na_restored[:scale]==[2.0,3.0,4.0]
na_model.start_operation('Remove Smoke Source References',true)
na_units = na_object_array.definition.entities.select { |na_item| na_item.get_attribute(na_serializer::NA_INSTANCE_DICT,'role')=='unit' }
na_object_array.definition.entities.erase_entities(na_units)
na_source_group.erase!
na_model.definitions.remove(na_source_definition) if na_source_definition.valid? && na_source_definition.instances.empty?
na_model.commit_operation
na_registry.Na__Registry__Clear()
na_restored = na_serializer.Na__Data__RestoreSource(na_object_array,na_object_data,true)
na_restored_child = na_restored[:definition].entities.find { |na_item| na_item.respond_to?(:definition) }
raise 'Native archive lost nested attributes.' unless na_restored_child && na_restored_child.get_attribute('Na__ArraySmoke','nested_marker')=='preserved'
raise 'Native archive lost face materials.' unless na_restored_child.definition.entities.grep(Sketchup::Face).all? { |na_item| na_item.material && na_item.material.color.red==255 }
na_builder.Na__Geometry__Update(na_model,na_object_array,na_object_config.merge('spacing_mm'=>75),'single',na_restored)
raise 'Recovered group array could not rebuild.' unless na_serializer.Na__Data__Load(na_object_array)['unit_count']>0
na_model.active_view.zoom_extents
puts 'Array Builder native geometry, union, nesting, source archive and Undo/Redo smoke check passed.'
puts 'Next: save/reopen this test model, reselect the custom array and edit it in Create / Edit Array.'
